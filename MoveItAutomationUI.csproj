<!-- Author: Marc R. Davis (marcdavis@comcast.net); Project: MAUI - MOVEit Automation UI. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MoveItAutomationUI</RootNamespace>
    <AssemblyName>MoveItAutomationUI</AssemblyName>
    <Authors>Marc R. Davis (marcdavis@comcast.net)</Authors>
    <Version>0.18.529-RC3</Version>
    <AssemblyVersion>0.18.529.0</AssemblyVersion>
    <FileVersion>0.18.529.0</FileVersion>
    <InformationalVersion>0.18.529-RC3+build.20261105</InformationalVersion>

    <!-- Separate tools/tests and any nested build output are outside the application.
         Keep these exclusions even when those projects are absent from the solution:
         switching branches or unpacking into a reused folder can leave their files behind.
         SDK targets still explicitly add MAUI's own generated assembly metadata. -->
    <!-- User Management remains on its own branch. Ignore its files in reused folders
         until its inclusion in master is explicitly approved. -->
    <MauiHeldFeatureItems>Features/UserManagement/**;Views/Configuration/_UserManagement*.cshtml;wwwroot/js/user-management.js;wwwroot/css/user-management.css;IntegrationAssets/MOVEitUserManagement/**</MauiHeldFeatureItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tools\**;Tools/**;MoveItAutomationUI.Tests\**;MoveItAutomationUI.Tests/**;**/bin/**;**/obj/**;$(MauiHeldFeatureItems)</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup><EmbeddedResource Include="Templates/Scripts/*.ps1" /></ItemGroup>

  <ItemGroup>
    <!-- Allow the dedicated MAUI test assembly to verify narrow native-portability contract helpers
         without widening those implementation details into MAUI's public runtime API. -->
    <InternalsVisibleTo Include="MoveItAutomationUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Separate project trees must not become application source or shipped content. -->
    <Compile Remove="Tools\**;Tools/**;MoveItAutomationUI.Tests\**;MoveItAutomationUI.Tests/**;$(MauiHeldFeatureItems)" />
    <Content Remove="Tools\**;Tools/**;MoveItAutomationUI.Tests\**;MoveItAutomationUI.Tests/**;$(MauiHeldFeatureItems)" />
    <None Remove="Tools\**;Tools/**;MoveItAutomationUI.Tests\**;MoveItAutomationUI.Tests/**;$(MauiHeldFeatureItems)" />
    <EmbeddedResource Remove="Tools\**;Tools/**;MoveItAutomationUI.Tests\**;MoveItAutomationUI.Tests/**;$(MauiHeldFeatureItems)" />
  </ItemGroup>

  <!-- Recheck separate project trees immediately before compilation. Do not remove
       MAUI's root obj metadata, which the SDK intentionally adds after evaluation. -->
  <Target Name="MauiExcludeNonApplicationCompileItems" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Remove="Tools\**;Tools/**;MoveItAutomationUI.Tests\**;MoveItAutomationUI.Tests/**;$(MSBuildProjectDirectory)/Tools/**;$(MSBuildProjectDirectory)/MoveItAutomationUI.Tests/**;Features/UserManagement/**;$(MSBuildProjectDirectory)/Features/UserManagement/**" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <!-- Installation-owned configuration must never enter build/publish packages.
         For a NEW installation only, create an existing {} file and grant its Modify ACL. -->
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>

    <!-- Release metadata must replace older output even when destination timestamps are newer.
         This does not change the separate installation-owned appsettings.json deployment rule. -->
    <Content Update="appsettings.template.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- Maintained customized configuration variant. It is shipped for explicit administrator use and is not loaded automatically. -->
    <Content Update="appsettings.custom.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Update="upgrade.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <!-- Release-owned CSV / Excel Task import template. Available alongside the deployed app,
         not inside wwwroot, so it is not automatically exposed as a public download. -->
    <None Update="Templates\TaskImport\MAUI_ImportTasksTemplate.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>

    <!-- Host import templates follow the same release-owned /Templates layout as
         TaskImport, including in dotnet publish / IIS deployment output. -->
    <None Update="Templates\HostImport\MAUI_HostImportTemplate.xlsx;Templates\HostImport\MAUI_HostImportTemplate.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Release-owned HTML email bodies supplied as text templates. -->
  <ItemGroup>
    <None Update="Templates\Email\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Data is entirely installation-owned: recovery snapshots, checkout journals,
       backups, SQLite files, cleanup state and machine-bound keys must never be
       copied from a developer/runtime installation into another deployment. -->
  <ItemGroup>
    <Content Remove="Data\**\*" />
    <None Remove="Data\**\*" />
    <None Include="Data\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="Build\Verify-ReleasePackage.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Use Windows PowerShell 5.1, available on supported IIS/Visual Studio hosts.
       Read-only checks fail before a mixed build/publish package reaches IIS.
       Separate targets also validate Publish when NoBuild is used. -->
  <Target Name="MauiVerifyBuildReleasePackage" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\Verify-ReleasePackage.ps1&quot; -PackageDirectory &quot;$(TargetDir).&quot; -ExpectedVersion &quot;$(Version)&quot;" />
  </Target>
  <Target Name="MauiVerifyPublishedReleasePackage" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true' and '$(IsPublishable)' != 'false'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\Verify-ReleasePackage.ps1&quot; -PackageDirectory &quot;$(PublishDir).&quot; -ExpectedVersion &quot;$(Version)&quot;" />
  </Target>
</Project>

