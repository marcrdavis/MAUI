@* Author: Marc R. Davis (marcdavis@comcast.net)
   Project: MAUI - MOVEit Automation UI
   This Razor file is part of the MAUI application. *@
@using System.Text.Json
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model TasksPageViewModel
@{
    ViewData["Title"] = "Tasks";
    var useMauiTaskEditor = !bool.TryParse(Configuration["Editors:UseMauiTaskEditor:Value"], out var enabledTaskEditor) || enabledTaskEditor;
    var taskJsonEditorEnabled = bool.TryParse(Configuration["Ui:TaskJsonEditor:Value"], out var jsonEditorEnabled) && jsonEditorEnabled;
    var useMauiHostEditor = bool.TryParse(Configuration["Editors:UseMauiHostEditor:Value"], out var enabledHostEditor) && enabledHostEditor;
    var filterLabel = Model.ActiveFilter switch
    {
        "running" => "Running",
        "success" => "Success",
        "failed" => "Failed",
        "no-transfers" => "No Transfers",
        _ => "All Tasks"
    };

    ViewData["GridSearchPrefixPartial"] = "_TaskFolderSearchControls";
    ViewData["TaskFolders"] = Model.Folders;
    ViewData["TaskSelectedFolderId"] = Model.SelectedFolderId;
    ViewData["TaskActiveFilter"] = Model.ActiveFilter;
    ViewData["GridToolbarRightPrefixPartial"] = "_TaskRefreshControls";
    ViewData["TaskLastRefreshUtc"] = Model.LastRefreshUtc;
    ViewData["GridDeferInitialLoad"] = true;

    var treeJson = JsonSerializer.Serialize(new
    {
        folders = Model.Folders.Select(folder => new { id = folder.Id, parentId = folder.ParentId, name = folder.Name }),
        tasks = Model.FolderTreeTasks.Select(task => new { id = task.Id, name = task.Name, folderId = task.FolderId })
    });
    var nativePortabilityDialogModel = new NativePortabilityDialogViewModel
    {
        ObjectType = "Task",
        PluralLabel = "Tasks",
        ShowLeaveTasksDisabled = true
    };
}
<div class="page-heading compact-heading">
    <div><h1>Tasks <span class="heading-context">/ @filterLabel</span></h1><p>Create, review, and manage MOVEit Automation Tasks.</p></div>
</div>

<div class="inline-alert license-capacity-alert" data-task-license-alert hidden>
    <strong data-task-license-title>Warning:</strong>
    <span data-task-license-message></span>
</div>

@if (TempData["TaskLoadError"] is string taskLoadError && !string.IsNullOrWhiteSpace(taskLoadError))
{
    <div class="inline-alert error-alert">@taskLoadError</div>
}

<partial name="_DataGrid" model="Model.Grid" />

<form class="task-antiforgery" hidden>@Html.AntiForgeryToken()</form>

<div data-task-page-config
     data-login-url="@Url.Action("SessionExpired", "Account")"
     data-task-details-url="@Url.Action("Details", "Tasks")"
     data-save-details-url="@Url.Action("SaveDetails", "Tasks")"
     data-use-maui-task-editor="@(useMauiTaskEditor ? "true" : "false")"
     data-host-editor-shell-url="@Url.Action("Shell", "HostEditor")"
     data-host-editor-save-url="@Url.Action("Save", "HostEditor")"
     data-host-editor-fingerprint-url="@Url.Action("Fingerprint", "HostEditor")"
     data-host-editor-certificates-url="@Url.Action("Certificates", "HostEditor")"
     data-host-editor-document-libraries-url="@Url.Action("DocumentLibraries", "HostEditor")"
     data-test-host-url="@Url.Action("TestHost", "Hosts")"
     data-clone-host-url="@Url.Action("CloneHost", "Hosts")"
     data-export-host-url="@Url.Action("ExportHost", "Hosts")"
     data-preflight-delete-hosts-url="@Url.Action("PreflightDeleteHosts", "Hosts")"
     data-delete-hosts-url="@Url.Action("DeleteHosts", "Hosts")"
     data-run-as-of-url="@Url.Action("RunAsOf", "TraditionalTaskEditor")"
     data-run-as-of-progress-url="@Url.Action("RunAsOfProgress", "TraditionalTaskEditor")"
     data-create-task-url="@Url.Action("CreateTask", "Tasks")"
     data-resource-groups-url="@Url.Action("ResourceGroupSetup", "Tasks")"
     data-new-task-groups-url="@Url.Action("AvailableCreationResourceGroups", "Tasks")"
     data-clone-task-url="@Url.Action("CloneTask", "Tasks")"
     data-create-advanced-task-url="@Url.Action("CreateAdvancedFromTraditional", "Tasks")"
     data-advanced-tasks-licensed="@(Model.AdvancedTasksLicensed ? "true" : "false")"
     data-export-task-url="@Url.Action("ExportTask", "Tasks")"
     data-preflight-import-task-url="@Url.Action("PreflightImportTask", "Tasks")"
     data-import-task-url="@Url.Action("ImportTask", "Tasks")"
     data-preview-task-spreadsheet-url="@Url.Action("PreviewTaskSpreadsheet", "Tasks")"
     data-analyze-task-spreadsheet-url="@Url.Action("AnalyzeTaskSpreadsheet", "Tasks")"
     data-import-task-spreadsheet-row-url="@Url.Action("ImportTaskSpreadsheetRow", "Tasks")"
     data-task-spreadsheet-import-row-limit="@Model.ImportRowLimit"
     data-run-task-now-url="@Url.Action("RunTaskNow", "Tasks")"
     data-preflight-kill-task-url="@Url.Action("PreflightKillTask", "Tasks")"
     data-kill-task-url="@Url.Action("KillTask", "Tasks")"
     data-enable-tasks-url="@Url.Action("EnableTasks", "Tasks")"
     data-disable-tasks-url="@Url.Action("DisableTasks", "Tasks")"
     data-resource-group-setup-url="@Url.Action("ResourceGroupSetup", "Tasks")"
     data-create-resource-group-url="@Url.Action("CreateResourceGroup", "Tasks")"
     data-add-to-resource-group-url="@Url.Action("AddToResourceGroup", "Tasks")"
     data-notification-setup-url="@Url.Action("NotificationSetup", "Tasks")"
     data-update-notification-url="@Url.Action("UpdateNotification", "Tasks")"
     data-save-notification-template-url="@Url.Action("SaveNotificationTemplate", "Tasks")"
     data-preflight-delete-tasks-url="@Url.Action("PreflightDeleteTasks", "Tasks")"
     data-delete-tasks-url="@Url.Action("DeleteTasks", "Tasks")"
     data-task-dependencies-url="@Url.Action("Dependencies", "Tasks")"
     data-task-logs-url="@Url.Action("Logs", "Tasks")"
     data-task-log-viewer-url="@Url.Action("LogViewer", "Tasks")"
     data-task-run-report-url="@Url.Action("TaskRun", "Records")"
     data-file-activity-report-url="@Url.Action("FileActivity", "Records")"
     data-audit-report-url="@Url.Action("Audit", "Records")"
     data-native-editor-session-url="@Url.Action("Session", "NativeEditor")"
     data-prepare-task-edit-url="@Url.Action("PrepareTaskEdit", "Tasks")"
     data-task-preflight-url="@Url.Action("PreflightStage", "Tasks")"
     data-preflight-undo-task-url="@Url.Action("PreflightUndoTask", "Tasks")"
     data-undo-task-url="@Url.Action("UndoTask", "Tasks")"
     data-mark-task-edited-url="@Url.Action("MarkTaskEdited", "Tasks")"
     data-initial-task-grid-url="@Url.Action("InitialGrid", "Tasks")"
     data-refresh-task-grid-url="@Url.Action("RefreshGrid", "Tasks")"
     data-ui-task-refresh-seconds="@Model.UiTaskRefreshIntervalSeconds"
     data-active-filter="@Model.ActiveFilter"
     data-selected-folder-id="@(Model.SelectedFolderId?.ToString() ?? string.Empty)"
     data-move-task-url="@Url.Action("MoveTask", "Tasks")"
     data-move-tasks-url="@Url.Action("MoveTasks", "Tasks")"
     data-create-folder-url="@Url.Action("CreateFolder", "Tasks")"
     data-rename-folder-url="@Url.Action("RenameFolder", "Tasks")"
     data-move-folder-url="@Url.Action("MoveFolder", "Tasks")"
     data-delete-folder-url="@Url.Action("DeleteFolder", "Tasks")"></div>

<script type="application/json" data-folder-tree-data>@Html.Raw(treeJson)</script>

<div class="task-row-action-menu" data-task-row-action-menu role="menu" aria-label="Task actions" hidden>
    <button type="button" role="menuitem" data-task-row-command="information">Task Information</button>
    <button type="button" role="menuitem" data-task-row-command="preflight">Preflight Check</button>
    <button type="button" role="menuitem" data-task-row-command="run-history">View Run History</button>
    <button type="button" role="menuitem" data-task-row-command="file-activity">View File Activity</button>
    <button type="button" role="menuitem" data-task-row-command="audit">View Audit Records</button>
    <div class="task-row-action-divider" role="separator"></div>
    <button type="button" role="menuitem" data-task-row-command="copy-name">Copy Task Name</button>
    <button type="button" role="menuitem" data-task-row-command="clone">Clone Task</button>
    <button type="button" role="menuitem" data-task-row-command="export">Export Task</button>
    <button type="button" role="menuitem" data-task-row-command="edit">Edit Task</button>
    <button type="button" role="menuitem" data-task-row-command="notifications">Edit Notifications</button>
    <button type="button" role="menuitem" data-task-row-command="undo">Undo Changes</button>
    <div class="task-row-action-divider" role="separator"></div>
    <button type="button" role="menuitem" data-task-row-command="toggle-enabled">Disable Task</button>
    <button type="button" role="menuitem" data-task-row-command="run">Run Task Now</button>
    <button type="button" role="menuitem" class="task-row-danger-action" data-task-row-command="kill">Kill Task</button>
    <button type="button" role="menuitem" class="task-row-danger-action" data-task-row-command="delete">Delete Task</button>
</div>

<dialog class="new-task-dialog" data-new-task-dialog>
    <form class="new-task-card" data-new-task-form>
        <header class="script-editor-header">
            <div class="script-editor-title-wrap"><span class="script-editor-icon" aria-hidden="true"><partial name="_Icon" model="@("tasks")" /></span><div><h2>New Task</h2><p>Create the Task in MOVEit and open the configured Task editor.</p></div></div>
            <button type="button" class="dialog-close" data-new-task-close aria-label="Close">×</button>
        </header>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-new-task-error hidden></div>

            @if (!Model.IsMoveItAdmin)
            {
                <label class="field-block full-span" data-new-task-resource-group-row>
                    <span>Resource Group</span>
                    <select class="text-input" data-new-task-resource-group required>
                        <option value="">Select a Resource Group</option>
                    </select>
                </label>
            }

            <label class="field-block full-span">
                <span>Task Name</span>
                <input class="text-input" type="text" maxlength="254" autocomplete="off" data-new-task-name />
            </label>
            <label class="new-task-auto-format" title="When enabled, converts the name to uppercase and replaces spaces with underscores. Example: My Task → MY_TASK.">
                <input type="checkbox" data-new-task-auto-format @(Model.AutoFormatNewTaskHostNames ? "checked" : null) />
                <span>Auto Format Name</span>
            </label>


            <fieldset class="new-task-type-fieldset">
                <legend>Task Type</legend>
                <label class="new-task-type-card">
                    <input type="radio" name="newTaskType" value="Traditional" checked />
                    <span class="new-task-type-copy">
                        <strong>Traditional</strong>
                        <span>Simple task that typically includes a source, a destination, and a schedule.</span>
                    </span>
                </label>
                @if (Model.AdvancedTasksLicensed)
                {
                    <label class="new-task-type-card">
                        <input type="radio" name="newTaskType" value="Advanced" />
                        <span class="new-task-type-copy">
                            <strong>Advanced</strong>
                            <span>Advanced tasks include advanced function such as loops and conditional blocks in addition to sources, destinations and processes.</span>
                        </span>
                    </label>
                }
                <label class="new-task-type-card">
                    <input type="radio" name="newTaskType" value="Synchronization" />
                    <span class="new-task-type-copy">
                        <strong>Synchronization</strong>
                        <span>Synchronization tasks keep the contents of two different folders in sync.</span>
                    </span>
                </label>
            </fieldset>


        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-new-task-cancel>Cancel</button>
            <button type="submit" class="primary-button new-task-submit" data-new-task-submit>
                <span class="inline-spinner button-spinner" data-new-task-spinner hidden aria-hidden="true"></span>
                <span data-new-task-submit-label>Create Task</span>
            </button>
        </div>
    </form>
</dialog>

<dialog class="new-task-dialog" data-clone-task-dialog>
    <form class="new-task-card" data-clone-task-form>
        <div class="settings-header">
            <div><h2>Clone Task</h2><p>Create a copy of this Task and continue configuring it in the selected Task Editor.</p></div>
            <button type="button" class="dialog-close" data-clone-task-close aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-clone-task-error hidden></div>

            <label class="field-block full-span">
                <span>Task Name</span>
                <input class="text-input" type="text" maxlength="254" autocomplete="off" data-clone-task-name />
                <small>The cloned Task will be created disabled so it cannot run until you review and enable it.</small>
            </label>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-clone-task-cancel>Cancel</button>
            <button type="submit" class="primary-button new-task-submit" data-clone-task-submit>
                <span class="inline-spinner button-spinner" data-clone-task-spinner hidden aria-hidden="true"></span>
                <span data-clone-task-submit-label>Create Task</span>
            </button>
        </div>
    </form>
</dialog>

<partial name="_NativePortabilityDialogs" model="nativePortabilityDialogModel" />

<dialog class="new-task-dialog" data-undo-task-dialog>
    <div class="new-task-card">
        <div class="settings-header">
            <div><h2>Undo Task Changes</h2><p>Select a saved version to restore.</p></div>
            <button type="button" class="dialog-close" data-undo-task-no aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-undo-task-error hidden></div>


            <p data-undo-task-message></p>
            <div class="undo-history-list" data-undo-task-history></div>
            <p><strong>The current Task configuration will be replaced by the selected version.</strong></p>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-undo-task-no>Cancel</button>
            <button type="button" class="danger-button" data-undo-task-yes>Restore Selected Version</button>
        </div>
    </div>
</dialog>

<dialog class="new-task-dialog" data-delete-tasks-dialog>
    <div class="new-task-card">
        <div class="settings-header">
            <div><h2 data-delete-tasks-title>Delete Tasks</h2><p>Deletes the selected Task or Tasks from MOVEit Automation. When available, MAUI saves a Recycle Bin recovery copy first.</p></div>
            <button type="button" class="dialog-close" data-delete-tasks-no aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-delete-tasks-error hidden></div>


            <p data-delete-tasks-message></p>
            <div class="delete-object-list" data-delete-tasks-list hidden></div>
            <p><strong>Are you sure you want to continue?</strong></p>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-delete-tasks-no>Cancel</button>
            <button type="button" class="danger-button" data-delete-tasks-yes>Yes, Delete</button>
        </div>
    </div>
</dialog>

<dialog class="new-task-dialog" data-kill-task-dialog>
    <div class="new-task-card">
        <div class="settings-header">
            <div><h2>Kill Task</h2><p>Immediately terminate the selected running task instance(s).</p></div>
            <button type="button" class="dialog-close" data-kill-task-no aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-kill-task-error hidden></div>


            <p data-kill-task-message></p>
            <p><strong>Warning:</strong> Killing a Task stops it immediately and may leave partially transferred or processed files.</p>
            <p><strong>Are you sure you want to continue?</strong></p>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-kill-task-no>Cancel</button>
            <button type="button" class="danger-button" data-kill-task-yes>Yes, Kill Task</button>
        </div>
    </div>
</dialog>


<dialog class="new-task-dialog task-preflight-dialog" data-task-preflight-dialog>
    <div class="new-task-card task-preflight-card">
        <div class="settings-header">
            <div><h2>Task Preflight Checks</h2><p data-task-preflight-subtitle>Validate the Task configuration and dependencies without running the Task.</p></div>
            <button type="button" class="dialog-close" data-task-preflight-close aria-label="Close">×</button>
        </div>
        <div class="new-task-body task-preflight-body">
            <div class="task-preflight-stages" data-task-preflight-stages aria-label="Preflight stages">
                <div class="task-preflight-stage" data-preflight-stage="task"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("tasks")" /></span><span>Task</span></div>
                <div class="task-preflight-stage" data-preflight-stage="hosts"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("host")" /></span><span>Hosts</span></div>
                <div class="task-preflight-stage" data-preflight-stage="resources"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("script")" /></span><span>Resources</span></div>
                <div class="task-preflight-stage" data-preflight-stage="certificates"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("key")" /></span><span>Certificates / Keys</span></div>
                <div class="task-preflight-stage" data-preflight-stage="notifications"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("mail")" /></span><span>Notifications</span></div>
                <div class="task-preflight-stage" data-preflight-stage="scheduling"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("calendar")" /></span><span>Scheduling</span></div>
                <div class="task-preflight-stage" data-preflight-stage="configuration"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("settings")" /></span><span>Configuration</span></div>
                <div class="task-preflight-stage" data-preflight-stage="runtime"><span class="task-preflight-stage-icon"><partial name="_Icon" model="@("clock")" /></span><span>Runtime</span></div>
            </div>
            <div class="task-preflight-summary" data-task-preflight-summary>Preflight has not started.</div>
            <div class="task-preflight-results-wrap">
                <table class="task-preflight-results-table">
                    <thead><tr><th>Result</th><th>Check</th><th>Details</th></tr></thead>
                    <tbody data-task-preflight-results></tbody>
                </table>
            </div>
        </div>
        <div class="settings-footer new-task-footer">
            <div class="maui-modal-feedback" data-maui-modal-feedback data-feedback-kind="error" role="alert" hidden></div>
            <button type="button" class="secondary-button" data-task-preflight-close>Close</button>
            <button type="button" class="primary-button" data-task-preflight-run-again>Run Preflight Again</button>
        </div>
    </div>
</dialog>


<dialog class="new-task-dialog task-notification-dialog" data-task-notification-dialog>
    <div class="new-task-card task-notification-card">
        <div class="settings-header">
            <div><h2>Task Notifications</h2><p data-task-notification-subtitle>Manage task-level email notifications for Traditional Tasks.</p></div>
            <button type="button" class="dialog-close" data-task-notification-close aria-label="Close">×</button>
        </div>
        <div class="new-task-body task-notification-body">
            <div class="inline-alert error-alert" data-task-notification-error hidden></div>
            <div class="inline-alert" data-task-notification-warning hidden></div>
            <div class="inline-alert warning-alert task-notification-multi-warning" data-task-notification-multi-warning hidden></div>

            <div data-task-notification-config>
                <div class="task-notification-existing-row" data-notification-existing-row hidden>
                    <label class="field-block">
                        <span>Notification</span>
                        <div class="task-notification-loading" data-notification-existing-loading hidden>
                            <span class="inline-spinner" aria-hidden="true"></span>
                            <span>Loading Notifications...</span>
                        </div>
                        <select class="text-input" data-notification-existing>
                            <option value="">Create New</option>
                        </select>
                    </label>
                </div>

                <fieldset class="task-notification-fieldset" data-notification-results-fieldset>
                    <legend>Email when Task result is</legend>
                    <label><input type="checkbox" data-notify-failure checked /> Failure</label>
                    <label><input type="checkbox" data-notify-no-action /> No Transfer</label>
                    <label><input type="checkbox" data-notify-success /> Success</label>
                </fieldset>

                <fieldset class="task-notification-fieldset">
                    <legend>Action</legend>
                    <label><input type="radio" name="taskNotificationMode" value="upsert" checked /> Add or Update</label>
                    <label><input type="radio" name="taskNotificationMode" value="remove" /> Remove</label>
                </fieldset>

                <div class="task-notification-fields" data-task-notification-message-fields>
                    <label class="field-block">
                        <span>Format</span>
                        <select class="text-input" data-notification-format><option value="html">HTML</option><option value="text">Text</option></select>
                    </label>
                    <label class="field-block">
                        <span>SMTP Host</span>
                        <select class="text-input" data-notification-host></select>
                    </label>
                    <label class="field-block full-span">
                        <span>Recipients</span>
                        <input class="text-input" type="text" data-notification-recipients placeholder="user@example.com; team@example.com" />
                    </label>
                    <label class="task-notification-preserve-recipients full-span">
                        <input type="checkbox" data-notification-preserve-recipients />
                        <span>Do not change existing recipients</span>
                    </label>
                    <label class="field-block full-span">
                        <span>Subject</span>
                        <div class="task-notification-insert-row">
                            <input class="text-input" type="text" data-notification-subject />
                            <select class="text-input task-notification-macro" data-notification-subject-macro aria-label="Insert macro into Subject"></select>
                        </div>
                    </label>
                    <div class="field-block full-span task-notification-message-field">
                        <span>Message Body</span>
                        <div class="task-notification-toolbar" data-notification-html-toolbar>
                            <button type="button" data-notification-command="bold" title="Bold"><strong>B</strong></button>
                            <button type="button" data-notification-command="italic" title="Italic"><em>I</em></button>
                            <button type="button" data-notification-command="underline" title="Underline"><u>U</u></button>
                            <button type="button" data-notification-command="insertUnorderedList" title="Bulleted list">• List</button>
                            <button type="button" data-notification-command="insertOrderedList" title="Numbered list">1. List</button>
                            <button type="button" data-notification-link title="Insert link">Link</button>
                            <button type="button" data-notification-html-toggle title="Edit HTML source">Source</button>
                            <select class="text-input task-notification-macro" data-notification-body-macro aria-label="Insert macro into Message Body"></select>
                            <div class="task-notification-template-picker">
                                <button type="button" data-notification-template-button title="Load a saved Subject and Message Body template">Templates</button>
                                <div class="task-notification-template-menu" data-notification-template-menu role="menu" hidden></div>
                            </div>
                            <button type="button" class="task-notification-save-template" data-notification-template-save title="Save Subject and Message Body as Template" aria-label="Save Subject and Message Body as Template">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12l2 2v16H5z"/><path d="M8 3v6h8V3M8 21v-7h8v7"/></svg>
                            </button>
                        </div>
                        <div class="task-notification-editor" contenteditable="true" data-notification-html-editor role="textbox" aria-multiline="true"></div>
                        <textarea class="text-input task-notification-html-source" rows="10" data-notification-html-source aria-label="HTML source" spellcheck="false" hidden></textarea>
                        <textarea class="text-input task-notification-textarea" rows="10" data-notification-text-editor hidden></textarea>
                    </div>
                </div>
                <p class="field-help full-span">MOVEit may mark a Task failed if its Send Email Next Action cannot be completed. Use a reliable SMTP Host.</p>
            </div>

            <div class="task-notification-progress" data-task-notification-progress hidden>
                <div class="task-notification-progress-heading"><strong data-notification-progress-title>Updating Notifications</strong><span data-notification-progress-count></span></div>
                <progress max="100" value="0" data-notification-progress-bar></progress>
                <div class="task-notification-current" data-notification-current></div>
                <div class="task-notification-summary" data-notification-summary></div>
                <div class="task-notification-results" data-notification-results></div>
            </div>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-task-notification-cancel>Close</button>
            <button type="button" class="primary-button" data-task-notification-apply>Add/Update</button>
        </div>
    </div>
</dialog>

<dialog class="new-task-dialog" data-notification-template-save-dialog>
    <div class="new-task-card task-notification-template-save-card">
        <div class="settings-header">
            <div><h2>Save Notification Template</h2><p>Save the current Subject and Message Body as a reusable notification template.</p></div>
            <button type="button" class="dialog-close" data-notification-template-save-close aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-notification-template-save-error hidden></div>
            <label class="field-block">
                <span>Template Name</span>
                <input class="text-input" type="text" maxlength="100" autocomplete="off" data-notification-template-save-name />
            </label>
            <label class="task-notification-template-overwrite" data-notification-template-overwrite-row hidden>
                <input type="checkbox" data-notification-template-overwrite />
                <span>Overwrite existing template <strong data-notification-template-overwrite-name></strong></span>
            </label>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-notification-template-save-cancel>Cancel</button>
            <button type="button" class="primary-button" data-notification-template-save-confirm>Save Template</button>
        </div>
    </div>
</dialog>

<dialog class="new-task-dialog" data-task-notification-confirm-dialog>
    <div class="new-task-card task-notification-confirm-card">
        <div class="settings-header">
            <div><h2>Confirm Notification Changes</h2><p>Confirm the notification operation before updating multiple Tasks.</p></div>
            <button type="button" class="dialog-close" data-task-notification-confirm-cancel aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <p data-task-notification-confirm-message></p>
            <p><strong>Are you sure you want to continue?</strong></p>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-task-notification-confirm-cancel>Cancel</button>
            <button type="button" class="primary-button" data-task-notification-confirm-continue>Continue</button>
        </div>
    </div>
</dialog>

<dialog class="new-task-dialog" data-notification-link-dialog>
    <div class="new-task-card task-notification-link-card">
        <div class="settings-header">
            <div><h2>Add Hyperlink</h2><p>Add a web or email link to the selected message text.</p></div>
            <button type="button" class="dialog-close" data-notification-link-cancel aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-notification-link-error hidden></div>
            <label class="field-block">
                <span>Link URL</span>
                <input class="text-input" type="text" autocomplete="off" placeholder="https://example.com or mailto:user@example.com" data-notification-link-url />
            </label>
            <p class="field-help">Links must begin with http://, https://, or mailto:.</p>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-notification-link-cancel>Cancel</button>
            <button type="button" class="primary-button" data-notification-link-confirm>Add Link</button>
        </div>
    </div>
</dialog>

<partial name="_TaskInformationDialog" />
<partial name="_ResourceGroupManagementDialogs" />

<dialog class="folder-manager-dialog" data-folder-manager-dialog>
    <div class="folder-manager-card folder-manager-card-single">
        <div class="settings-header">
            <div><h2>Manage Task Folders</h2><p>Drag tasks or folders to reorganize them. Shift-click tasks to select a range. Right-click a folder for folder actions.</p></div>
            <button type="button" class="dialog-close" data-folder-manager-close aria-label="Close">×</button>
        </div>
        <div class="folder-manager-body-single">
            <div class="inline-alert error-alert folder-tree-error" data-folder-error hidden></div>

            <div class="folder-tree-single" data-folder-tree-container aria-label="Task folder tree" aria-multiselectable="true"></div>

        </div>
        <div class="settings-footer">
            <span class="folder-manager-tip">Shift-click to select multiple tasks, then drag any selected task. Drop on <strong>All Tasks</strong> to remove folder assignment.</span>
            <button type="button" class="primary-button" data-folder-manager-close>Close</button>
        </div>
    </div>

    <div class="folder-context-menu" data-folder-context-menu hidden>
        <button type="button" data-folder-context-action="new">New Folder</button>
        <button type="button" data-folder-context-action="rename">Rename Folder</button>
        <button type="button" data-folder-context-action="delete" class="danger-context-action">Delete Folder</button>
    </div>
</dialog>

