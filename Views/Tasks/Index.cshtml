@section Scripts {
    @if (taskJsonEditorEnabled)
    {
        <link rel="stylesheet" href="~/css/editors/task-json-editor.css" asp-append-version="true" />
        <script src="~/js/editors/task-json-model.js" asp-append-version="true"></script>
        <script src="~/js/editors/task-json-editor.js" asp-append-version="true"></script>
    }
    @if (useMauiTaskEditor)
    {
        <link rel="stylesheet" href="~/css/editors/traditional-task-editor.css" asp-append-version="true" />
        <script src="~/js/shared/traditional-task-field-macros.js" asp-append-version="true"></script>
        <link rel="stylesheet" href="~/css/editors/advanced-task-editor.css" asp-append-version="true" />
        <script src="~/js/editors/advanced-task-flow.js" asp-append-version="true"></script>
        <script src="~/js/editors/advanced-task-editor.js" asp-append-version="true"></script>
        <script src="~/js/editors/task-run-as-of.js" asp-append-version="true"></script>
        <script src="~/js/editors/task-script-guidance.js" asp-append-version="true"></script>
        <script src="~/js/editors/traditional-task-editor.js" asp-append-version="true"></script>
        @if (useMauiHostEditor)
        {
            <link rel="stylesheet" href="~/css/editors/host-editor.css" asp-append-version="true" />
            <script src="~/js/editors/host-editor.js" asp-append-version="true"></script>
            <script src="~/js/editors/task-host-editor.js" asp-append-version="true"></script>
        }
    }
    <script src="~/js/task-information.js" asp-append-version="true"></script>
    <script src="~/js/native-portability.js" asp-append-version="true"></script>
    @if (useMauiTaskEditor && useMauiHostEditor)
    {
        <script src="~/js/shared/host-actions.js" asp-append-version="true"></script>
    }
    <script src="~/js/task-spreadsheet-import.js" asp-append-version="true"></script>
    <script src="~/js/resource-groups.js" asp-append-version="true"></script>
    <script src="~/js/tasks.js" asp-append-version="true"></script>
}

