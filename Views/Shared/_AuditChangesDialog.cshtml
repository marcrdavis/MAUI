@* Read-only native audit comparison. No editor/checkouts or configuration changes. *@
<dialog class="task-details-dialog" data-audit-changes-dialog
        data-details-url="@Url.Action("Details", "AuditChanges")" aria-labelledby="audit-changes-title">
    <form method="dialog" class="task-details-card report-details-card audit-changes-card">
        <div class="settings-header">
            <div><h2 id="audit-changes-title">Configuration Changes</h2><p data-audit-changes-context>Audit record</p></div>
            <button type="submit" class="dialog-close" aria-label="Close">×</button>
        </div>
        <div class="audit-changes-summary" data-audit-changes-summary hidden aria-live="polite"></div>
        <div class="report-details-body audit-changes-body" data-audit-changes-body aria-busy="false">
            <p class="empty-state" data-audit-changes-state role="status">Loading configuration changes…</p>
            <table class="audit-changes-table" data-audit-changes-table hidden aria-label="Configuration changes before and after">
                <thead><tr><th scope="col">Before</th><th scope="col">After</th><th scope="col" aria-label="Change">±</th><th scope="col">Configuration</th></tr></thead>
                <tbody data-audit-changes-lines></tbody>
            </table>
        </div>
        <div class="settings-footer new-task-footer">
            <p class="maui-modal-feedback inline-alert error-alert" data-audit-changes-error data-maui-modal-feedback data-feedback-kind="error" data-feedback-origin="modal" role="alert" hidden></p>
            <button type="submit" class="secondary-button">Close</button>
        </div>
    </form>
</dialog>
