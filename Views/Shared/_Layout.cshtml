@* Author: Marc R. Davis (marcdavis@comcast.net)
   Project: MAUI - MOVEit Automation UI
   This Razor file is part of the MAUI application. *@
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using MoveItAutomationUI.Services.Lifecycle
@{
    var ui = UiOptionsAccessor.Value;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isLogin = controller.Equals("Account", StringComparison.OrdinalIgnoreCase) && action.Equals("Login", StringComparison.OrdinalIgnoreCase);
    var isSetup = controller.Equals("Setup", StringComparison.OrdinalIgnoreCase);
    var isUpgrade = controller.Equals("Upgrade", StringComparison.OrdinalIgnoreCase);
    var isPublicShell = isLogin || isSetup || isUpgrade;
    // Only highlight a child filter when that filter is explicitly present in the URL.
    // Opening the Tasks/Hosts parent itself should expand the menu without visually selecting All.
    var taskFilter = controller.Equals("Tasks", StringComparison.OrdinalIgnoreCase)
        ? Context.Request.Query["filter"].ToString().ToLowerInvariant()
        : string.Empty;
    var hostFilter = controller.Equals("Hosts", StringComparison.OrdinalIgnoreCase)
        ? Context.Request.Query["filter"].ToString().ToLowerInvariant()
        : string.Empty;
    var currentUser = User.Identity?.Name ?? Context.Request.Cookies[MauiAuthenticationDefaults.UserDisplayCookieName] ?? "—";
    var currentServer = User.FindFirst(MauiAuthenticationDefaults.ServerNameClaimType)?.Value
        ?? Context.Request.Cookies[MauiAuthenticationDefaults.ServerDisplayCookieName]
        ?? ui.DefaultServer;
    // Match browser idle warnings to the effective startup policy, not the unswitched
    // settings document. Ordinary Settings changes take effect after application restart.
    // A digest scopes the tab's grid warning to this login, environment, and IIS application;
    // the actual server-side session identifier is never exposed to browser storage.
    var moveItGridScope = isPublicShell || User.Identity?.IsAuthenticated != true ? string.Empty
        : Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(
            $"{Context.Request.PathBase}|{User.FindFirst(MoveItAutomationUI.Services.MoveIt.MoveItSessionService.SessionIdClaimType)?.Value}|{User.FindFirst(MauiAuthenticationDefaults.ServerKeyClaimType)?.Value}")));
    var idleSessionTimeoutMinutes = Context.RequestServices
        .GetRequiredService<MoveItAutomationUI.Services.Configuration.ConfigurationStartupState>()
        .IdleSessionTimeoutMinutes;
    // Public lifecycle pages must not query normal database-backed MAUI authorization. Initial Setup can
    // render before the metadata schema exists, and Login/Upgrade already use their own lifecycle authorization.
    var isAdmin = isPublicShell
        ? User.IsInRole(MauiSecurityRoles.Admin)
        : User.Identity?.IsAuthenticated == true && MauiSecurityService.IsAdmin(User.Identity.Name);
    // Defer session-service resolution during Setup; it must not capture pre-Setup MOVEit settings.
    var activeMoveItSession = isPublicShell ? null : Context.RequestServices.GetRequiredService<IMoveItSessionService>().Get();
    var isMoveItAdmin = activeMoveItSession?.Info?.IsAdmin == true;
    var environmentCopyEnabled = !isPublicShell && isAdmin && isMoveItAdmin
        && Context.RequestServices.GetRequiredService<MoveItAutomationUI.Features.EnvironmentCopy.EnvironmentCopyCoordinator>().Enabled;
    MoveItAutomationUI.Services.MoveIt.MoveItCreationAccess? objectCreationAccess = null;
    if (activeMoveItSession is not null)
    {
        try { objectCreationAccess = await Context.RequestServices.GetRequiredService<IMoveItObjectAccessService>().GetCreationAsync(); }
        catch (Exception ex) when (ex is MoveItApiException or InvalidOperationException or HttpRequestException
            || (ex is OperationCanceledException && !Context.RequestAborted.IsCancellationRequested))
        { objectCreationAccess = new(false, new Dictionary<string, string[]>()); }
    }

    var reportReturnScope = Context.Request.Query["reportReturn"].ToString();
    var returnToMyReports = (controller.Equals("Reports", StringComparison.OrdinalIgnoreCase)
        && action.Equals("My", StringComparison.OrdinalIgnoreCase))
        || reportReturnScope.Equals("mine", StringComparison.OrdinalIgnoreCase);
    var requestedReportsReturnUrl = Context.Request.Query["reportReturnUrl"].ToString();
    // Url.IsLocalUrl only checks the website origin; also require the active IIS application prefix.
    var reportsWorkspaceUrl = !string.IsNullOrWhiteSpace(requestedReportsReturnUrl)
        && Url.IsLocalUrl(requestedReportsReturnUrl)
        && MauiApplicationReturnUrls.IsWithinApplication(requestedReportsReturnUrl, Context.Request.PathBase)
        ? requestedReportsReturnUrl
        : returnToMyReports
            ? Url.Action("My", "Reports")
            : isAdmin ? Url.Action("Index", "Reports") : Url.Action("My", "Reports");
    var recycleBinEnabled = RecycleBinOptionsAccessor.Value.Enabled.Value;
    var useMauiTaskEditor = !bool.TryParse(Configuration["Editors:UseMauiTaskEditor:Value"], out var enabledTaskEditor) || enabledTaskEditor;
    var useMauiScriptEditor = bool.TryParse(Configuration["Editors:UseMauiScriptEditor:Value"], out var enabledScriptEditor) && enabledScriptEditor;
    var useMauiDateListEditor = bool.TryParse(Configuration["Editors:UseMauiDateListEditor:Value"], out var enabledDateListEditor) && enabledDateListEditor;
    var useMauiGroupsAndPermissionsEditor = bool.TryParse(Configuration["Editors:UseMauiGroupsAndPermissionsEditor:Value"], out var enabledGroupsAndPermissionsEditor) && enabledGroupsAndPermissionsEditor;
    var useMauiSystemSettingsEditor = bool.TryParse(Configuration["Editors:UseMauiSystemSettingsEditor:Value"], out var enabledSystemSettingsEditor) && enabledSystemSettingsEditor;
    var useMauiHostEditor = bool.TryParse(Configuration["Editors:UseMauiHostEditor:Value"], out var enabledHostEditor) && enabledHostEditor;
    var systemMessageOptions = SystemMessageOptionsAccessor.Value;
    var systemMessageType = SystemMessageOptions.SupportedMessageTypes.FirstOrDefault(type => type.Equals(systemMessageOptions.MessageType.Value, StringComparison.OrdinalIgnoreCase)) ?? "Information";
    var systemMessageBody = systemMessageOptions.MessageBody.Value?.Trim() ?? string.Empty;
    var systemMessageDismissed = activeMoveItSession?.SystemMessageDismissed ?? false;
    var showSystemMessage = !isPublicShell && systemMessageOptions.Enabled.Value && systemMessageBody.Length > 0 && !systemMessageDismissed;
    var systemMessageCssType = systemMessageType.ToLowerInvariant();
    var systemMessageIcon = systemMessageType switch
    {
        "Important" => "warning",
        "Critical" => "critical",
        _ => "info"
    };
    var userPreferences = isPublicShell ? UserPreferencesService.GetDefaults() : await UserPreferencesService.GetCurrentAsync();
    IReadOnlyList<SavedViewSummary> savedViews = isPublicShell ? Array.Empty<SavedViewSummary>() : await SavedViewService.GetCurrentAsync();
    var activeSavedViewId = Context.Request.Query["savedView"].ToString();
    var activeReportEditId = Context.Request.Query["reportEdit"].ToString();
    var activeSavedView = savedViews.FirstOrDefault(view => view.Id.Equals(activeSavedViewId, StringComparison.OrdinalIgnoreCase));
    var hasActiveSavedView = activeSavedView is not null;
}
<!DOCTYPE html>
<html lang="en"
      data-object-access-url="@Url.Action("Object", "ObjectAccess")"
      data-object-access-batch-url="@Url.Action("Objects", "ObjectAccess")"
      data-object-creation-access-url="@Url.Action("Creation", "ObjectAccess")"
      data-host-editor-preferences-url="@Url.Action("SavePreferences", "HostEditor")"
      data-object-edit-lease-open-url="@Url.Action("Open", "ObjectEditLease")"
      data-object-edit-lease-override-url="@Url.Action("Override", "ObjectEditLease")"
      data-object-edit-lease-heartbeat-url="@Url.Action("Heartbeat", "ObjectEditLease")"
      data-object-edit-lease-close-url="@Url.Action("Close", "ObjectEditLease")"
