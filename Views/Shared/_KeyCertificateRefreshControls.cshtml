@{
    var lastRefreshUtc = ViewData["KeyCertificateLastRefreshUtc"] is System.DateTimeOffset value ? value.ToString("O") : string.Empty;
}
<div class="task-refresh-control" data-key-certificate-refresh-control data-last-refresh-utc="@lastRefreshUtc">
    <span class="task-last-refresh" data-key-certificate-last-refresh aria-live="polite">Last Refresh: --:--:--</span>
    <div class="menu-control task-refresh-menu" data-menu>
        <button type="button" class="task-refresh-clock-button" data-menu-button data-key-certificate-refresh-clock aria-label="Keys and Certificates refresh options" title="Keys and Certificates refresh options">
            <span class="icon"><partial name="_Icon" model="@("clock")" /></span>
        </button>
        <div class="dropdown-menu dropdown-right task-refresh-menu-panel" data-menu-panel>
            <button type="button" data-key-certificate-refresh-toggle>Pause Refresh</button>
            <button type="button" data-key-certificate-refresh-now>Refresh Now</button>
        </div>
    </div>
</div>
