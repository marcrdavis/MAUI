@* Typed projections share one modal; native Globals, lockout policy and trusted IPs keep their own save contracts. *@
<dialog class="new-task-dialog script-editor-dialog is-editing system-settings-editor-dialog" data-system-settings-editor aria-labelledby="system-settings-editor-title"
        data-shell-url="@Url.Action("Shell", "SystemSettingsEditor")" data-save-url="@Url.Action("Save", "SystemSettingsEditor")"
        data-lockout-url="@Url.Action("Lockout", "SystemSettingsEditor")"
        data-active-lockouts-url="@Url.Action("ActiveLockouts", "SystemSettingsEditor")" data-unlock-url="@Url.Action("Unlock", "SystemSettingsEditor")"
        data-browse-url="@Url.Action("Browse", "HostEditor", new { id = "0" })">
    <form class="new-task-card script-editor-card" data-system-form novalidate>
        <header class="script-editor-header">
            <div class="script-editor-title-wrap">
                <span class="script-editor-icon" aria-hidden="true"><partial name="_Icon" model="@("settings")" /></span>
                <div><h2 id="system-settings-editor-title">MOVEit Settings</h2><p>Manage MOVEit Automation settings.</p></div>
            </div>
            <button type="button" class="dialog-close" data-system-close aria-label="Close">×</button>
        </header>
        <div class="task-details-tabs script-editor-tabs" role="tablist" aria-label="MOVEit Settings sections">
            <button type="button" class="task-details-tab active" id="system-tab-logging" role="tab" aria-selected="true" aria-controls="system-panel-logging" data-system-tab="logging">Logging</button>
            <button type="button" class="task-details-tab" id="system-tab-events" role="tab" aria-selected="false" aria-controls="system-panel-events" data-system-tab="events" tabindex="-1">Windows Event Log</button>
            <button type="button" class="task-details-tab" id="system-tab-tasks" role="tab" aria-selected="false" aria-controls="system-panel-tasks" data-system-tab="tasks" tabindex="-1">Tasks</button>
            <button type="button" class="task-details-tab" id="system-tab-state" role="tab" aria-selected="false" aria-controls="system-panel-state" data-system-tab="state" tabindex="-1">State File</button>
            <button type="button" class="task-details-tab" id="system-tab-tamper" role="tab" aria-selected="false" aria-controls="system-panel-tamper" data-system-tab="tamper" tabindex="-1">Tamper Detection</button>
            <button type="button" class="task-details-tab" id="system-tab-lockout" role="tab" aria-selected="false" aria-controls="system-panel-lockout" data-system-tab="lockout" tabindex="-1">IP/User Lockout Policy</button>
            <button type="button" class="task-details-tab" id="system-tab-active-lockouts" role="tab" aria-selected="false" aria-controls="system-panel-active-lockouts" data-system-tab="active-lockouts" tabindex="-1">Lockouts</button>
            <div class="script-editor-tab-actions system-settings-tab-actions" data-system-active-actions hidden>
                <button type="button" class="task-refresh-clock-button" data-system-active-refresh aria-label="Refresh Lockouts" title="Refresh Lockouts"><span class="icon"><partial name="_Icon" model="@("clock")" /></span></button>
            </div>
        </div>
        <div class="new-task-body system-settings-body" data-system-body>
            <section role="tabpanel" id="system-panel-logging" aria-labelledby="system-tab-logging" data-system-panel="logging">
                <fieldset class="maui-property-card system-settings-fields" data-system-fields="globals" aria-label="Logging settings" disabled>
                    <div class="script-editor-fields">
                        <label class="field-block full-span"><span>System Log Level</span><select class="text-input" data-system-group="logging" data-system-field="debugLevel">
                            <option value="0">Internal Errors</option><option value="10">Task/File Errors</option><option value="20">Task/File Warnings</option><option value="30">Task Completions</option><option value="40">File Completions</option><option value="50">Some Debug</option><option value="60">More Debug</option><option value="70">All Debug</option>
                        </select></label>
                        <label class="system-settings-check full-span"><input type="checkbox" data-system-group="logging" data-system-field="logToDisk" /><span>Save System Log to Disk</span></label>
                        <label class="field-block"><span>System Log File Name</span><input class="text-input" type="text" data-system-group="logging" data-system-field="logFile" autocomplete="off" /></label>
                        <div class="field-block"><label for="system-max-log-size">Maximum System Log File Size</label><div class="system-settings-size">
                            <input id="system-max-log-size" class="text-input" type="number" min="0" step="any" data-system-size />
                            <select class="text-input" data-system-unit aria-label="Log file size unit"><option value="1024">KB</option><option value="1048576">MB</option><option value="1073741824">GB</option></select>
                        </div></div>
                        <label class="system-settings-check full-span"><input type="checkbox" data-system-group="logging" data-system-field="logToTaskLog" /><span>Enable Task Logs</span></label>
                        <div class="field-block full-span"><label for="system-task-log-dir">Task Log Directory</label><div class="system-settings-path"><input id="system-task-log-dir" class="text-input" type="text" data-system-group="logging" data-system-field="taskLogDir" autocomplete="off" /><button type="button" class="secondary-button" data-system-browse="taskLogDir">Browse...</button></div></div>
                        <div class="field-block full-span"><label for="system-asx-log-dir">Directory for ASx Logs</label><div class="system-settings-path"><input id="system-asx-log-dir" class="text-input" type="text" data-system-group="logging" data-system-field="as2LogDirectory" autocomplete="off" /><button type="button" class="secondary-button" data-system-browse="as2LogDirectory">Browse...</button></div></div>
                        <label class="field-block"><span>Default Number of Task Logs Saved</span><input class="text-input" type="number" min="0" max="2147483647" step="1" data-system-group="logging" data-system-field="numTaskLogsToKeep" /></label>
                        <label class="system-settings-check full-span"><input type="checkbox" data-system-group="logging" data-system-field="auditXferRetries" /><span>Audit Transfer Retry Attempts</span></label>
                    </div>
                </fieldset>
            </section>
            <section role="tabpanel" id="system-panel-events" aria-labelledby="system-tab-events" data-system-panel="events" hidden><fieldset class="maui-property-card system-settings-fields" data-system-fields="globals" aria-label="Windows Event Log settings" disabled><div class="script-editor-fields"><label class="field-block full-span"><span>Log Name</span><select class="text-input" data-system-group="eventLog" data-system-field="eventLogName"><option value="Application">Application</option><option value="MOVEit">MOVEit</option></select></label><label class="field-block"><span>Log Level</span><select class="text-input" data-system-group="eventLog" data-system-field="eventLogLevel"><option value="0">Internal Errors</option><option value="10">Task/File Errors</option><option value="20">Task/File Warnings</option><option value="30">Task Completions</option><option value="40">File Completions</option></select></label><label class="field-block"><span>Audit Log Level</span><select class="text-input" data-system-group="eventLog" data-system-field="eventLogAuditLevel"><option value="0">None</option><option value="10">Only Errors</option><option value="30">All</option></select></label></div></fieldset></section>
            <section role="tabpanel" id="system-panel-tasks" aria-labelledby="system-tab-tasks" data-system-panel="tasks" hidden><fieldset class="maui-property-card system-settings-fields" data-system-fields="globals" aria-label="Task settings" disabled><div class="script-editor-fields"><label class="field-block"><span>Maximum Running Tasks</span><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="tasks" data-system-field="maxSimulTasks" /></label><label class="system-settings-check full-span"><input type="checkbox" data-system-group="tasks" data-system-field="allowMultRuns" /><span>Allow Multiple Runs of Same Task (Does not affect ASx Tasks)</span></label><label class="system-settings-check full-span"><input type="checkbox" data-system-group="tasks" data-system-field="suppressQueuedTasksAtStartup" /><span>Suppress Queued Tasks on Startup</span></label><label class="field-block"><span>Notification Polling Interval (seconds)</span><input class="text-input" type="number" min="0" max="2147483647" step="1" data-system-group="tasks" data-system-field="pollIntervalSecs" /></label><label class="field-block"><span>AS2 Polling Interval (seconds)</span><input class="text-input" type="number" min="0" max="2147483647" step="1" data-system-group="tasks" data-system-field="as2PollIntervalSecs" /></label><p class="system-settings-hint full-span">If AS2 Polling Interval is 0, the Notification Polling Interval value will be used.</p></div></fieldset></section>
            <section role="tabpanel" id="system-panel-state" aria-labelledby="system-tab-state" data-system-panel="state" hidden><fieldset class="maui-property-card system-settings-fields" data-system-fields="globals" aria-label="State File settings" disabled><div class="script-editor-fields"><div class="field-block full-span"><span>Keep task state information cached</span><div class="system-settings-radio-list">
<label class="system-settings-check"><input type="radio" name="system-cache-mode" value="always" data-system-cache-mode /><span>Always</span></label>
<label class="system-settings-check"><input type="radio" name="system-cache-mode" value="task" data-system-cache-mode /><span>Until end of task run</span></label>
<div class="system-settings-inline"><label class="system-settings-check"><input type="radio" name="system-cache-mode" value="timed" data-system-cache-mode /><span>For</span></label><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-cache-time aria-label="State cache duration" /><select class="text-input" data-system-cache-unit aria-label="State cache duration unit"><option value="Minutes">Minutes</option><option value="Hours">Hours</option></select></div>
</div></div></div></fieldset></section>
            <section role="tabpanel" id="system-panel-tamper" aria-labelledby="system-tab-tamper" data-system-panel="tamper" hidden><fieldset class="maui-property-card system-settings-fields" data-system-fields="globals" aria-label="Tamper Detection settings" disabled><div class="script-editor-fields"><label class="system-settings-check full-span"><input type="checkbox" data-system-group="tamper" data-system-field="enabled" /><span>Tamper Detection</span></label></div></fieldset></section>
            <section role="tabpanel" id="system-panel-lockout" aria-labelledby="system-tab-lockout" data-system-panel="lockout" class="system-settings-policy" hidden><fieldset class="maui-property-card system-settings-fields" data-system-fields="lockout" aria-label="IP Lockout" disabled>
 <div class="system-settings-section-heading"><h3>IP Lockout</h3><label class="system-settings-toggle"><span data-system-lockout-status="ip">Disabled</span><span class="configuration-switch"><input type="checkbox" data-system-group="lockout" data-system-field="ipLockoutEnabled" aria-label="Enable IP Lockout" /><span aria-hidden="true"></span></span></label></div>
 <div class="system-settings-lockout-rule"><span>Lockout IPs after</span><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="lockout" data-system-field="ipLockoutTries" aria-label="IP Lockout attempts" /><span>attempts in</span><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="lockout" data-system-field="ipLockoutTime" aria-label="IP Lockout time" /><select class="text-input" data-system-group="lockout" data-system-field="ipLockoutUnits" aria-label="IP Lockout time unit"><option value="hours">Hours</option><option value="minutes">Minutes</option><option value="days">Days</option></select></div>
 <div class="system-settings-radio-list"><span class="system-settings-label">Lockout expiration</span>
 <label class="system-settings-check"><input type="radio" name="system-ip-expiry" value="never" data-system-auto="ip" /><span>Never</span></label>
 <div class="system-settings-inline"><label class="system-settings-check"><input type="radio" name="system-ip-expiry" value="timed" data-system-auto="ip" /><span>Expire after</span></label><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="lockout" data-system-field="ipUnlockTime" aria-label="IP Lockout expiration time" /><select class="text-input" data-system-group="lockout" data-system-field="ipUnlockUnits" aria-label="IP Lockout expiration time unit"><option value="hours">Hours</option><option value="minutes">Minutes</option><option value="days">Days</option></select></div></div>
 </fieldset><fieldset class="maui-property-card system-settings-fields" data-system-fields="lockout" aria-label="User Lockout" disabled>
 <div class="system-settings-section-heading"><h3>User Lockout</h3><label class="system-settings-toggle"><span data-system-lockout-status="user">Disabled</span><span class="configuration-switch"><input type="checkbox" data-system-group="lockout" data-system-field="userLockoutEnabled" aria-label="Enable User Lockout" /><span aria-hidden="true"></span></span></label></div>
 <div class="system-settings-lockout-rule"><span>Lockout users after</span><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="lockout" data-system-field="userLockoutTries" aria-label="User Lockout attempts" /><span>attempts in</span><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="lockout" data-system-field="userLockoutTime" aria-label="User Lockout time" /><select class="text-input" data-system-group="lockout" data-system-field="userLockoutUnits" aria-label="User Lockout time unit"><option value="hours">Hours</option><option value="minutes">Minutes</option><option value="days">Days</option></select></div>
 <div class="system-settings-radio-list"><span class="system-settings-label">Lockout expiration</span>
 <label class="system-settings-check"><input type="radio" name="system-user-expiry" value="never" data-system-auto="user" /><span>Never</span></label>
 <div class="system-settings-inline"><label class="system-settings-check"><input type="radio" name="system-user-expiry" value="timed" data-system-auto="user" /><span>Expire after</span></label><input class="text-input" type="number" min="1" max="2147483647" step="1" data-system-group="lockout" data-system-field="userUnlockTime" aria-label="User Lockout expiration time" /><select class="text-input" data-system-group="lockout" data-system-field="userUnlockUnits" aria-label="User Lockout expiration time unit"><option value="hours">Hours</option><option value="minutes">Minutes</option><option value="days">Days</option></select></div></div>
 </fieldset><fieldset class="maui-property-card system-settings-fields" data-system-fields="lockout" aria-label="Trusted IP Addresses" disabled><div class="system-settings-section-heading"><div><h3>Trusted IP Addresses</h3><p class="system-settings-hint">Enter IP addresses that will be exempt from the policies.</p></div></div><div class="system-settings-trusted-list" data-system-trusted-list></div><button type="button" class="secondary-button" data-system-trusted-add>Add another IP address</button></fieldset></section>
            <section role="tabpanel" id="system-panel-active-lockouts" aria-labelledby="system-tab-active-lockouts" data-system-panel="active-lockouts" class="system-settings-active-lockouts" hidden>
                <section class="maui-property-card" data-system-lockouts-kind="ip" aria-labelledby="system-lockouts-ip-title">
                    <div class="system-settings-section-heading"><div class="system-settings-lockouts-title"><h3 id="system-lockouts-ip-title">Locked out addresses</h3><span class="script-editor-count" data-system-lockouts-count>—</span></div><button type="button" class="secondary-button" data-system-unlock-selected disabled>Unlock selected IP addresses</button></div>
                    <div class="system-settings-lockouts-list" data-system-lockouts-list aria-busy="false">
                        <table class="data-grid-table system-settings-lockouts-table" aria-label="Locked out addresses"><thead><tr class="column-header-row">
                            <th class="select-column"><input type="checkbox" data-system-lockouts-all aria-label="Select all locked out addresses" disabled /></th>
                            <th aria-sort="none"><button type="button" class="sort-button" data-system-lockouts-sort="value">IP Address<span class="sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="system-settings-lockouts-date" aria-sort="descending"><button type="button" class="sort-button" data-system-lockouts-sort="stamp">Lockout Date<span class="sort-indicator" aria-hidden="true">↓</span></button></th>
                            <th class="system-settings-lockouts-action" aria-label="Actions"></th>
                        </tr></thead><tbody data-system-lockouts-rows><tr><td colspan="4" class="system-settings-lockouts-empty">Select Lockouts to load the list.</td></tr></tbody></table>
                    </div>
                </section>
                <section class="maui-property-card" data-system-lockouts-kind="user" aria-labelledby="system-lockouts-user-title">
                    <div class="system-settings-section-heading"><div class="system-settings-lockouts-title"><h3 id="system-lockouts-user-title">Locked out users</h3><span class="script-editor-count" data-system-lockouts-count>—</span></div><button type="button" class="secondary-button" data-system-unlock-selected disabled>Unlock selected users</button></div>
                    <div class="system-settings-lockouts-list" data-system-lockouts-list aria-busy="false">
                        <table class="data-grid-table system-settings-lockouts-table" aria-label="Locked out users"><thead><tr class="column-header-row">
                            <th class="select-column"><input type="checkbox" data-system-lockouts-all aria-label="Select all locked out users" disabled /></th>
                            <th aria-sort="none"><button type="button" class="sort-button" data-system-lockouts-sort="value">Username<span class="sort-indicator" aria-hidden="true"></span></button></th>
                            <th class="system-settings-lockouts-date" aria-sort="descending"><button type="button" class="sort-button" data-system-lockouts-sort="stamp">Lockout Date<span class="sort-indicator" aria-hidden="true">↓</span></button></th>
                            <th class="system-settings-lockouts-action" aria-label="Actions"></th>
                        </tr></thead><tbody data-system-lockouts-rows><tr><td colspan="4" class="system-settings-lockouts-empty">Select Lockouts to load the list.</td></tr></tbody></table>
                    </div>
                </section>
            </section>
        </div>
        <footer class="settings-footer script-editor-footer">
            <div class="script-editor-status" data-system-status role="status" aria-live="polite"></div>
            <button type="button" class="secondary-button" data-system-reload hidden>Reload MOVEit Settings</button>
            <button type="button" class="secondary-button" data-system-close>Close</button>
            <button type="submit" class="primary-button" data-system-save disabled>Save</button>
        </footer>
    </form>
</dialog>
