@* User Group ACL assignments share the Group resource picker appearance; native permission grants are unchanged. *@
<dialog class="new-task-dialog script-editor-dialog resource-group-picker resource-user-groups" data-user-group-dialog aria-labelledby="user-group-title">
    <form class="new-task-card" data-user-group-form novalidate>
        <header class="script-editor-header">
            <div class="script-editor-title-wrap"><span class="script-editor-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v2"/></svg></span><div><h2 id="user-group-title">Add User Groups</h2><p data-user-group-subtitle></p></div></div>
            <button type="button" class="dialog-close" data-user-group-close aria-label="Close">×</button>
        </header>
        <div class="new-task-body resource-group-picker-body">
            <div class="inline-alert error-alert" role="alert" data-user-group-error hidden></div>
            <div class="resource-user-group-filters">
                <label class="field-block"><span>User Group Type</span><select class="text-input" data-user-group-type><option value="local">Local</option><option value="remote">Domain</option></select></label>
                <label class="search-box"><span class="icon"><partial name="_Icon" model="@("search")" /></span><input type="search" data-user-group-search placeholder="Search group name or description" aria-label="Search group name or description" autocomplete="off" /></label>
                <button type="button" class="secondary-button" data-user-group-reload>Reload Lists</button>
            </div>
            <div class="resource-group-picker-table resource-user-group-table"><table class="resource-group-inventory-table"><thead><tr><th><input type="checkbox" data-user-group-all aria-label="Select all matching unassigned User Groups" /></th><th>Group Name</th><th>Description</th></tr></thead><tbody data-user-group-items></tbody></table></div>
            <p class="permissions-help">New assignments have all permissions off. Local and Domain selections are retained when switching lists.</p>
            <ul class="resource-user-group-results" data-user-group-results hidden></ul>
        </div>
        <div class="settings-footer new-task-footer"><span class="resource-group-status" data-user-group-count aria-live="polite">0 selected</span><button type="button" class="secondary-button" data-user-group-close>Cancel</button><button type="submit" class="primary-button" data-user-group-save disabled>Save</button></div>
    </form>
</dialog>
<dialog class="new-task-dialog script-editor-dialog" data-user-group-remove-dialog aria-labelledby="remove-user-group-title">
    <form class="new-task-card" data-user-group-remove-form>
        <header class="script-editor-header"><div><h2 id="remove-user-group-title">Remove User Group</h2><p>Remove this assignment from the Resource Group.</p></div><button type="button" class="dialog-close" data-user-group-remove-close aria-label="Close">×</button></header>
        <div class="new-task-body">
            <div class="inline-alert error-alert" role="alert" data-user-group-remove-error hidden></div>
            <label class="field-block"><span>Resource Group</span><input class="text-input" data-user-group-remove-resource readonly /></label>
            <label class="field-block"><span>User Group</span><input class="text-input" data-user-group-remove-name readonly /></label>
            <p class="permissions-help">This removes its permission assignment. The Windows User Group and Resource Group resources are retained.</p>
        </div>
        <div class="settings-footer new-task-footer"><button type="button" class="secondary-button" data-user-group-remove-close>Cancel</button><button type="submit" class="danger-button" data-user-group-remove-confirm>Remove User Group</button></div>
    </form>
</dialog>
