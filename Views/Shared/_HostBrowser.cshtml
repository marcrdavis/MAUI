@* Shared Host browser: callers supply transport and selection behavior. *@
<dialog class="new-task-dialog maui-host-browser-dialog" data-host-browser aria-labelledby="maui-host-browser-title">
    <div class="new-task-card maui-host-browser-card">
        <div class="settings-header">
            <div>
                <h2 id="maui-host-browser-title" data-host-browser-title>Browse Folders</h2>
                <p data-host-browser-host></p>
            </div>
            <button type="button" class="dialog-close" data-host-browser-cancel aria-label="Close">×</button>
        </div>
        <div class="new-task-body maui-host-browser-body">
            <div class="inline-alert error-alert" data-host-browser-error hidden></div>
            <label class="field-block">
                <span>Location</span>
                <span class="maui-host-browser-input-action">
                    <input class="text-input" data-host-browser-location autocomplete="off" />
                    <button type="button" class="secondary-button" data-host-browser-refresh>Refresh</button>
                </span>
            </label>
            <div class="maui-host-browser-list">
                <button type="button" class="maui-host-browser-parent" data-host-browser-parent hidden><span aria-hidden="true">↑</span> Back to Parent</button>
                <div class="maui-host-browser-header"><button type="button" data-folder-browser-sort="name" aria-label="Sort by Name" aria-sort="none"><span>Name</span><span class="sort-indicator" aria-hidden="true"></span></button><button type="button" data-folder-browser-sort="size" aria-label="Sort by Size" aria-sort="none"><span>Size</span><span class="sort-indicator" aria-hidden="true"></span></button><button type="button" data-folder-browser-sort="lastModified" aria-label="Sort by Last Modified" aria-sort="none"><span>Last Modified</span><span class="sort-indicator" aria-hidden="true"></span></button></div>
                <div class="maui-host-browser-loading" data-host-browser-loading hidden role="status" aria-live="polite"><span class="inline-spinner" aria-hidden="true"></span><span>Loading folders…</span></div>
                <div class="maui-host-browser-empty" data-host-browser-empty hidden>No folders or files were returned for this location.</div>
                <div class="maui-host-browser-rows" data-host-browser-rows></div>
            </div>
            <p class="field-help" data-host-browser-hint>Double-click a folder to open it. Double-click a file to select its folder and filename, or select a folder and click OK to keep the filename unchanged.</p>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-host-browser-cancel>Close</button>
            <button type="button" class="primary-button" data-host-browser-ok>OK</button>
        </div>
    </div>
</dialog>
