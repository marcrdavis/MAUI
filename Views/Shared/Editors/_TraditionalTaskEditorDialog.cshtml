@* RC2 MAUI Traditional Task editor shell. *@
<dialog class="traditional-task-editor-dialog"
        data-traditional-task-editor-dialog
        data-traditional-task-editor-shell-url='@Url.Action("Shell", "TraditionalTaskEditor")'
        data-script-metadata-url='@Url.Action("ScriptMetadata", "TraditionalTaskEditor")'
        data-traditional-task-editor-save-url='@Url.Action("Save", "TraditionalTaskEditor")'
        data-traditional-task-editor-preferences-url='@Url.Action("SavePreferences", "TraditionalTaskEditor")'
        data-traditional-task-editor-transfer-exceptions-url='@Url.Action("TransferExceptions", "TraditionalTaskEditor")'
        data-traditional-task-editor-delete-transfer-exceptions-url='@Url.Action("DeleteTransferExceptions", "TraditionalTaskEditor")'
        data-traditional-task-editor-source-timestamps-url='@Url.Action("SourceTimestamps", "TraditionalTaskEditor")'
        data-traditional-task-editor-update-source-timestamp-url='@Url.Action("UpdateSourceTimestamp", "TraditionalTaskEditor")'
        data-sync-preview-url='@Url.Action("SyncPreview", "TraditionalTaskEditor")'
        data-sync-action-url='@Url.Action("SyncAction", "TraditionalTaskEditor")'
        data-traditional-task-editor-browse-url='@Url.Action("BrowseFolders", "TraditionalTaskEditor")'>
    <div class="traditional-task-editor-card">
        <div class="traditional-task-editor-header">
            <div class="traditional-task-editor-title-group">
                <span class="traditional-task-editor-mark icon" aria-hidden="true"><partial name="_Icon" model="@("tasks")" /></span>
                <div class="traditional-task-editor-title-copy">
                    <span class="traditional-task-editor-kicker" data-task-editor-kind-label>Traditional Task Editor</span>
                    <h2 data-traditional-task-editor-title>Task</h2>
                    <p data-traditional-task-editor-description>No description</p>
                </div>
            </div>
            <button type="button" class="dialog-close" data-traditional-task-editor-close aria-label="Close">×</button>
        </div>

        <div class="task-details-tabs traditional-task-editor-tabs" role="tablist" aria-label="Traditional Task editor sections">
            <button type="button" class="task-details-tab active" role="tab" aria-selected="true" data-traditional-task-editor-tab="task">Task</button>
            <button type="button" class="task-details-tab" role="tab" aria-selected="false" data-traditional-task-editor-tab="properties">Properties</button>
            <button type="button" class="task-details-tab" role="tab" aria-selected="false" data-traditional-task-editor-tab="advanced">Advanced</button>
            <button type="button" class="task-details-tab" role="tab" aria-selected="false" data-traditional-task-editor-tab="logs">Task Logs</button>
            <div class="traditional-task-editor-tab-actions">
                <label class="traditional-task-editor-auto-save" title="Automatically save writable changes to MOVEit Automation">
                    <span>Auto Save</span>
                    <span class="configuration-switch">
                        <input type="checkbox" data-traditional-task-editor-auto-save />
                        <span aria-hidden="true"></span>
                    </span>
                </label>
                <label class="traditional-task-editor-auto-save traditional-task-editor-enable-control" title="Enable or disable this Task">
                    <span data-traditional-task-editor-enabled-label>Task Enabled</span>
                    <span class="configuration-switch">
                        <input type="checkbox" data-editor-field="enabled" data-traditional-task-editor-enabled />
                        <span aria-hidden="true"></span>
                    </span>
                </label>
                <div class="traditional-task-editor-actions-control">
                    <button type="button" class="secondary-button" data-traditional-task-editor-actions aria-haspopup="menu" aria-expanded="false">
                        Actions <span class="button-caret" aria-hidden="true">⌄</span>
                    </button>
                    <div class="traditional-task-editor-actions-menu" data-traditional-task-editor-actions-menu role="menu" hidden>
                        <button type="button" role="menuitem" data-traditional-task-editor-undo disabled title="No editor change is available to undo.">Undo Last Change</button>
                        <div class="task-row-action-divider" role="separator"></div>
                        <button type="button" role="menuitem" data-traditional-task-editor-task-parameters>Task Parameters</button>
                        <button type="button" role="menuitem" data-traditional-task-editor-transfer-exceptions>Transfer Exceptions</button>
                        <button type="button" role="menuitem" data-traditional-task-editor-preflight>Preflight Check</button>
                        <button type="button" role="menuitem" data-traditional-task-editor-run-now>Run Now</button>
                        <button type="button" role="menuitem" data-traditional-task-editor-run-as-of disabled>Run As Of…</button>
                        <div class="task-row-action-divider" role="separator" data-sync-only hidden></div>
                        <button type="button" role="menuitem" data-sync-action="swap" data-sync-only hidden>Swap Sync Folders</button>
                        <button type="button" role="menuitem" data-sync-action="clear-listings" data-sync-only hidden>Clear Sync Listings</button>
                        <button type="button" role="menuitem" data-sync-view-preview data-sync-only hidden>View Sync Preview</button>
                        <div class="task-row-action-divider" role="separator"></div>
                        <button type="button" role="menuitem" data-traditional-task-editor-clone>Clone Task</button>
                        <button type="button" role="menuitem" data-traditional-task-editor-create-advanced>Create Advanced Task</button>
                        <button type="button" role="menuitem" data-traditional-task-editor-export>Export Task</button>
                        <button type="button" role="menuitem" data-advanced-save-flow hidden>Save Task Flow</button>
                        <div class="task-row-action-divider" role="separator"></div>
                        <button type="button" role="menuitem" class="danger-menu-item" data-traditional-task-editor-delete>Delete Task</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="traditional-task-editor-body">
            <div class="details-loading" data-traditional-task-editor-loading>Loading task editor…</div>
            <div class="inline-alert error-alert traditional-task-editor-error" data-traditional-task-editor-error hidden></div>

            <div class="traditional-task-editor-content" data-traditional-task-editor-content hidden>
                <section class="traditional-task-editor-panel traditional-task-editor-task-panel" data-traditional-task-editor-panel="task">
                    <aside class="traditional-task-editor-rail" aria-label="Task configuration sections">
                        <div class="traditional-task-editor-rail-section" data-traditional-task-editor-section="sync-settings" data-sync-only hidden>
                            <button type="button" class="traditional-task-editor-rail-heading" data-traditional-task-editor-section-button="sync-settings" aria-expanded="false">
                                <span class="icon"><partial name="_Icon" model="@("tasks")" /></span><strong>Sync Settings</strong><span class="traditional-task-editor-rail-caret" aria-hidden="true">›</span>
                            </button>
                        </div>
                        <div class="traditional-task-editor-rail-section active" data-traditional-task-editor-section="steps">
                            <button type="button" class="traditional-task-editor-rail-heading" data-traditional-task-editor-section-button="steps" aria-expanded="true">
                                <span class="icon"><partial name="_Icon" model="@("layers")" /></span>
                                <strong><span data-task-editor-folders-label>Steps</span> <span data-traditional-task-editor-step-count>(0)</span></strong>
                                <span class="traditional-task-editor-rail-caret" aria-hidden="true">›</span>
                            </button>
                            <div class="traditional-task-editor-rail-items">
                                <div class="traditional-task-editor-step-list" data-traditional-task-editor-step-items></div>
                                <div class="traditional-task-editor-add-control">
                                    <button type="button" class="secondary-button traditional-task-editor-add-button" data-traditional-task-editor-add-step aria-haspopup="menu" aria-expanded="false">+ Add Step <span class="button-caret" aria-hidden="true">⌄</span></button>
                                    <div class="traditional-task-editor-add-menu" data-traditional-task-editor-add-step-menu role="menu" hidden>
                                        <button type="button" role="menuitem" data-traditional-task-editor-add-source>Add Source</button>
                                        <button type="button" role="menuitem" data-traditional-task-editor-add-process>Add Process</button>
                                        <button type="button" role="menuitem" data-traditional-task-editor-add-destination>Add Destination</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="traditional-task-editor-rail-section" data-traditional-task-editor-section="schedules">
                            <button type="button" class="traditional-task-editor-rail-heading" data-traditional-task-editor-section-button="schedules" aria-expanded="false">
                                <span class="icon"><partial name="_Icon" model="@("calendar")" /></span>
                                <strong>Schedules <span data-traditional-task-editor-schedule-count>(0)</span></strong>
                                <span class="traditional-task-editor-rail-caret" aria-hidden="true">›</span>
                            </button>
                            <div class="traditional-task-editor-rail-items" hidden>
                                <div class="traditional-task-editor-schedule-list" data-traditional-task-editor-schedule-items></div>
                                <button type="button" class="secondary-button traditional-task-editor-add-button" data-traditional-task-editor-add-schedule>+ Add Schedule</button>
                            </div>
                        </div>

                        <div class="traditional-task-editor-rail-section" data-traditional-task-editor-section="next-actions">
                            <button type="button" class="traditional-task-editor-rail-heading" data-traditional-task-editor-section-button="next-actions" aria-expanded="false">
                                <span class="icon"><partial name="_Icon" model="@("mail")" /></span>
                                <strong>Next Actions <span data-traditional-task-editor-next-action-count>(0)</span></strong>
                                <span class="traditional-task-editor-rail-caret" aria-hidden="true">›</span>
                            </button>
                            <div class="traditional-task-editor-rail-items" hidden>
                                <div class="traditional-task-editor-next-action-list" data-traditional-task-editor-next-action-items></div>
                                <div class="traditional-task-editor-add-control">
                                    <button type="button" class="secondary-button traditional-task-editor-add-button" data-traditional-task-editor-add-next-action aria-haspopup="menu" aria-expanded="false">+ Add Next Action <span class="button-caret" aria-hidden="true">⌄</span></button>
                                    <div class="traditional-task-editor-add-menu traditional-task-editor-next-action-add-menu" data-traditional-task-editor-add-next-action-menu role="menu" hidden>
                                        <button type="button" role="menuitem" data-traditional-task-editor-add-email-action>Send Email</button>
                                        <button type="button" role="menuitem" data-traditional-task-editor-add-run-task-action>Run Task</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="advanced-mobile-navigation" data-advanced-mobile hidden><button type="button" class="secondary-button" data-advanced-view="flow">Flow</button><button type="button" class="secondary-button" data-advanced-view="properties">Properties</button></div>
                    </aside>

                    <section class="advanced-task-editor-flow-pane" data-advanced-flow-pane hidden aria-label="Advanced Task flow">
                        <div class="advanced-flow-tree-scroll"><div data-advanced-flow-tree></div></div>
                    </section>
                    <div class="advanced-flow-divider" data-advanced-divider title="Drag to resize flow and properties, or focus and use the arrow keys." role="separator" aria-label="Resize flow and properties" aria-orientation="vertical" aria-valuemin="25" aria-valuemax="70" aria-valuenow="40" tabindex="0"></div>
                    <div class="traditional-task-editor-workspace">
                        <div class="traditional-task-editor-workspace-panel" data-traditional-task-editor-workspace="sync-settings" hidden>
                            <div class="traditional-task-editor-workspace-heading"><div><span class="traditional-task-editor-workspace-kicker">Synchronization</span><h3>Sync Settings</h3><p>Folder A and Folder B use the same folder editor and Host overrides.</p></div></div>
                            <div class="traditional-task-editor-form-card">
                                <div class="details-grid">
                                    <label class="field-block full-span"><span>Sync Type</span><select class="text-input" data-sync-direction data-editor-field="syncDirection"><option value="unidirectional">Unidirectional: Folder A → Folder B</option><option value="bidirectional">Bidirectional: Folder A ⇄ Folder B</option></select></label>
                                    <label class="field-block full-span"><span>Sync Deletes</span><select class="text-input" data-sync-deletes data-editor-field="syncDeletePolicy"><option value="0">Ignore deletes</option><option value="1">Synchronize deleted files and folders</option><option value="2">Synchronize deletes and delete extra files in Folder B</option></select></label>
                                    <label class="traditional-task-editor-inline-check full-span"><input type="checkbox" data-sync-comparisons data-editor-field="syncCaseSensitive" /><span>Case Sensitive Comparisons</span></label>
                                    <p class="field-help full-span">Use case sensitive comparisons when both folders use case sensitive file systems, such as Linux, S3 or Azure Blob.</p>
                                    <input type="hidden" data-editor-field="syncInitialRun" />
                                    <input type="hidden" data-editor-field="syncSameSeconds" />
                                </div>
                            </div>
                            <div class="inline-alert info-alert">Saving changes to Sync Type, Sync Deletes or filename comparisons clears the Sync listing and disables the Task. Review a Sync Preview before enabling it. Initial-run options control which files are transferred after the listing is cleared.</div>

                        </div>
                        <div class="traditional-task-editor-workspace-panel" data-traditional-task-editor-workspace="advanced-step" data-advanced-inspector hidden></div>
                        <div class="traditional-task-editor-workspace-panel" data-traditional-task-editor-workspace="steps">
                            <div class="traditional-task-editor-step-empty" data-traditional-task-editor-step-empty>
                                <span class="icon" aria-hidden="true"><partial name="_Icon" model="@("layers")" /></span>
                                <h3>Select or add a task step</h3>
                                <p>Select an existing step from the left or add a new step.</p>
                            </div>

                            <div data-traditional-task-editor-step-detail hidden>
                                <div class="traditional-task-editor-workspace-heading">
                                    <div>
                                        <span class="traditional-task-editor-workspace-kicker" data-traditional-task-editor-step-kicker>Selected Step</span>
                                        <h3 data-traditional-task-editor-step-title>Step Properties</h3>
                                        <p data-traditional-task-editor-step-summary></p>
                                    </div>
                                    <div class="traditional-task-editor-step-actions-control">
                                        <button type="button" class="secondary-button traditional-task-editor-step-actions-button" data-traditional-task-editor-step-actions aria-haspopup="menu" aria-expanded="false" title="Step actions" aria-label="Step actions">⋯</button>
                                        <div class="traditional-task-editor-step-actions-menu" data-traditional-task-editor-step-actions-menu role="menu" hidden>
                                            <button type="button" role="menuitem" data-traditional-task-editor-step-action="change-host" data-sync-only hidden>Change Host</button>
                                            <button type="button" role="menuitem" data-traditional-task-editor-step-action="clone">Clone Step</button>
                                            <button type="button" role="menuitem" data-traditional-task-editor-step-action="source-timestamps">Edit Source Timestamps</button>
                                            <div class="task-row-action-divider" role="separator"></div>
                                            <button type="button" role="menuitem" class="danger-menu-item" data-traditional-task-editor-step-action="delete">Delete Step</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="traditional-task-editor-step-placeholder" data-traditional-task-editor-generic-step hidden>
                                    <div class="inline-alert info-alert" data-traditional-task-editor-generic-step-message>This step type is not mapped in the MAUI editor yet.</div>
                                </div>

                                <div class="traditional-task-editor-source" data-traditional-task-editor-source hidden>
                                    <div class="traditional-task-editor-subtabs" role="tablist" aria-label="Source step properties">
                                        <button type="button" class="active" data-traditional-task-editor-source-tab="general">General</button>
                                        <button type="button" data-traditional-task-editor-source-tab="after-transfer">After Transfer</button>
                                        <button type="button" data-traditional-task-editor-source-tab="additional-commands" hidden>Additional Commands</button>
                                        <button type="button" data-traditional-task-editor-source-tab="host-overrides">Host Overrides</button>
                                    </div>

                                    <div class="traditional-task-editor-source-panel" data-traditional-task-editor-source-panel="general">
                                        <div class="traditional-task-editor-form-card">
                                            <div class="details-grid traditional-task-editor-source-host-grid">
                                                <label class="field-block full-span"><span>Host Type</span><select class="text-input" data-traditional-task-editor-source-host-type-filter></select></label>
                                                <div class="field-block full-span"><span id="traditional-task-editor-source-host-label">Host</span><div class="traditional-task-editor-host-select-row"><select class="text-input" aria-labelledby="traditional-task-editor-source-host-label" data-source-field="hostId" data-traditional-task-editor-source-host></select><button type="button" class="secondary-button" data-traditional-task-editor-edit-host="Source" hidden>Edit Host</button></div><small data-traditional-task-editor-source-host-help></small></div>
                                                <label class="field-block full-span" data-source-s3-general-only hidden><span>Bucket Name</span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="bucket" data-traditional-task-editor-source-bucket /><button type="button" class="secondary-button" data-traditional-task-editor-source-bucket-browse>Browse</button></span><small data-traditional-task-editor-source-bucket-help></small></label>
                                                <label class="field-block full-span" data-source-azureblob-general-only hidden><span>Container</span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="container" data-traditional-task-editor-source-container /><button type="button" class="secondary-button" data-traditional-task-editor-source-container-browse>Browse</button></span><small data-traditional-task-editor-source-container-help></small></label>
                                                <label class="field-block full-span" data-source-sharepoint-general-only hidden><span>Document Library</span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="documentLibrary" data-traditional-task-editor-source-document-library readonly /><button type="button" class="secondary-button" data-traditional-task-editor-source-document-library-browse>Browse</button></span><small data-traditional-task-editor-source-document-library-help></small></label>
                                                <label class="field-block full-span" data-source-non-pop3><span>Folder(s)</span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="path" data-traditional-task-editor-source-path /><button type="button" class="secondary-button" data-traditional-task-editor-source-browse>Browse</button><select class="text-input traditional-task-editor-field-macro" data-traditional-task-editor-field-macro data-macro-context="source-path" data-macro-target='[data-source-field="path"]' aria-label="Insert macro into Source Folder(s)"></select></span><small class="traditional-task-editor-folder-macro-warning" data-traditional-task-editor-source-browse-warning hidden>Folders containing macros cannot be browsed. Remove the macro to use Browse.</small></label>
                                                <label class="traditional-task-editor-inline-check full-span" data-source-non-pop3><input type="checkbox" data-source-field="searchSubdirectories" /> <span>Search subdirectories</span></label>
                                                <label class="field-block full-span traditional-task-editor-check-with-value" data-source-non-pop3><span class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="ignoreFolders" /> <span>Ignore folder(s)</span></span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="excludeFolders" placeholder="Folder mask" /><select class="text-input traditional-task-editor-field-macro" data-traditional-task-editor-field-macro data-macro-context="source-path" data-macro-target='[data-source-field="excludeFolders"]' aria-label="Insert macro into ignored folder mask"></select></span></label>
                                                <label class="field-block full-span"><span>File(s)</span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="fileMask" placeholder="File name or wildcard pattern" /><select class="text-input traditional-task-editor-field-macro" data-traditional-task-editor-field-macro data-macro-context="source-file" data-macro-target='[data-source-field="fileMask"]' aria-label="Insert macro into Source File(s)"></select></span></label>
                                                <label class="field-block full-span traditional-task-editor-check-with-value"><span class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="ignoreFiles" /> <span>Ignore file(s)</span></span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="excludeFiles" placeholder="File mask" /><select class="text-input traditional-task-editor-field-macro" data-traditional-task-editor-field-macro data-macro-context="source-file" data-macro-target='[data-source-field="excludeFiles"]' aria-label="Insert macro into ignored file mask"></select></span></label>
                                            </div>
                                            <div class="traditional-task-editor-source-options">
                                                <div class="traditional-task-editor-option-action-row" data-source-non-pop3>
                                                    <label class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="hasSpecialFilters" /> <span>Special Filters</span></label>
                                                    <button type="button" class="secondary-button compact-button" data-traditional-task-editor-special-filters>Edit</button>
                                                </div>
                                                <div class="traditional-task-editor-option-note traditional-task-editor-special-filter-summary" data-source-non-pop3 data-traditional-task-editor-special-filter-status>No filters configured.</div>
                                                <label class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="collectOnlyNewFiles" /> <span>Collect only new files</span></label>
                                                <label class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="expandZipFiles" /> <span>Expand zip files</span></label>
                                                <label class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="retryIfNoFilesFound" /> <span>Retry if no files found</span></label>
                                            </div>
                                            <div class="details-grid" data-sync-only hidden>
                                                <label class="traditional-task-editor-inline-check full-span"><input type="checkbox" data-source-field="overridePreserveFileTimestamp" /> <span>Override default preserve file timestamp</span></label>
                                                <label class="traditional-task-editor-inline-check full-span traditional-task-editor-sync-timestamp-value"><input type="checkbox" data-source-field="preserveFileTimestamp" /> <span>Preserve file timestamp</span></label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="traditional-task-editor-source-panel" data-traditional-task-editor-source-panel="after-transfer" hidden>
                                        <div class="traditional-task-editor-form-card">
                                            <div class="traditional-task-editor-field-heading">After successful transfer</div>
                                            <div class="traditional-task-editor-radio-list">
                                                <label><input type="radio" name="traditional-task-editor-delete-original" value="0" data-source-field="deleteOriginalAction" /> <span>Do nothing</span></label>
                                                <label><input type="radio" name="traditional-task-editor-delete-original" value="1" data-source-field="deleteOriginalAction" /> <span>Delete original file(s)</span></label>
                                                <label data-source-rename-original-option><input type="radio" name="traditional-task-editor-delete-original" value="2" data-source-field="deleteOriginalAction" /> <span>Rename original file(s)</span></label>
                                            </div>
                                            <div class="traditional-task-editor-after-transfer-rename" data-traditional-task-editor-rename-options>
                                                <label class="field-block full-span"><span>Rename To</span><span class="traditional-task-editor-input-action"><input class="text-input" data-source-field="renameTo" placeholder="File name or MOVEit macro expression" /><select class="text-input traditional-task-editor-field-macro" data-traditional-task-editor-field-macro data-macro-context="runtime-file" data-macro-target='[data-source-field="renameTo"]' aria-label="Insert macro into Rename To"></select></span></label>
                                                <label class="traditional-task-editor-inline-check"><input type="checkbox" data-source-field="renamedFilesMayOverwrite" /> <span>Renamed files may overwrite existing files</span></label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="traditional-task-editor-source-panel" data-traditional-task-editor-source-panel="additional-commands" hidden>
                                        <div class="traditional-task-editor-form-card">
                                            <div class="details-grid">
                                                <label class="field-block full-span"><span>Commands to execute (per file) before transfer</span><textarea class="text-input traditional-task-editor-command-textarea" data-source-field="additionalCommandsBefore" rows="4"></textarea><small>One FTP quote command per line. MOVEit macros are supported.</small></label>
                                                <label class="field-block full-span"><span>Commands to execute (per file) after transfer</span><textarea class="text-input traditional-task-editor-command-textarea" data-source-field="additionalCommandsAfter" rows="4"></textarea><small>One FTP quote command per line. MOVEit macros are supported.</small></label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="traditional-task-editor-source-panel" data-traditional-task-editor-source-panel="host-overrides" hidden>
                                        <div class="traditional-task-editor-host-override-heading">
                                            <div><strong data-traditional-task-editor-source-host-type>Host Overrides</strong><span>These values override settings configured on the selected Host for this Source only.</span></div>
                                        </div>
                                        <div class="traditional-task-editor-host-override-unsupported inline-alert info-alert" data-traditional-task-editor-host-override-unsupported hidden></div>
                                        @* Host-profile extension point. Keep protocol-specific controls inside this container; the Task Editor shell/workspace hierarchy is stable. *@
                                        <div data-traditional-task-editor-host-override-supported>
                                            <div class="traditional-task-editor-subtabs traditional-task-editor-host-subtabs" role="tablist" aria-label="Host override property groups">
                                                <button type="button" data-traditional-task-editor-host-tab="authentication" hidden>Authentication</button>
                                                <button type="button" data-traditional-task-editor-host-tab="file-sorting" hidden>File Sorting</button>
                                                <button type="button" class="active" data-traditional-task-editor-host-tab="timeouts">Timeouts</button>
                                                <button type="button" data-traditional-task-editor-host-tab="transfer">Transfer</button>
