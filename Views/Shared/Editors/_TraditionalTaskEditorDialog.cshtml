            <table class="traditional-task-editor-sync-preview-table">
                <thead><tr><th colspan="3" scope="colgroup">Folder A</th><th rowspan="2" scope="col">Action</th><th colspan="3" scope="colgroup">Folder B</th></tr><tr><th scope="col">Path</th><th scope="col">Size</th><th scope="col">Timestamp</th><th scope="col">Path</th><th scope="col">Size</th><th scope="col">Timestamp</th></tr></thead>
