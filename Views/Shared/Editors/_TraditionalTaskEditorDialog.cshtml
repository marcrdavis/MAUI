    <div class="settings-footer new-task-footer"><button type="button" class="secondary-button" data-sync-initial-close>Close</button><button type="button" class="primary-button" data-sync-initial-save>Save</button></div>
    </div>
</dialog>

<dialog class="new-task-dialog" data-run-as-of-dialog>
    <div class="new-task-card">
        <div class="settings-header"><div><h2>Run As Of…</h2><p>Temporarily use a selected date and time for Source and Destination filenames and folders that use date-time macros.</p></div><button type="button" class="dialog-close" data-run-as-of-close aria-label="Close">×</button></div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-run-as-of-error role="alert" hidden></div>
            <div class="field-block">
                <span id="run-as-of-date-label">Date and Time</span>
                <div class="run-as-of-date-entry">
                    <input type="datetime-local" class="text-input" step="1" required aria-labelledby="run-as-of-date-label" data-run-as-of-date />
                    <button type="button" class="secondary-button run-as-of-date-toggle" aria-label="Choose date and time" aria-haspopup="dialog" aria-expanded="false" aria-controls="run-as-of-date-picker" data-run-as-of-picker-toggle>
                        <span class="icon"><partial name="_Icon" model="@("calendar")" /></span>
                    </button>
                </div>
                <div id="run-as-of-date-picker" class="run-as-of-date-picker" popover="auto" role="dialog" aria-label="Choose date and time" data-run-as-of-picker>
                    <div class="run-as-of-date-navigation">
                        <button type="button" class="run-as-of-date-arrow" aria-label="Previous month" data-run-as-of-picker-prev>‹</button>
                        <select class="text-input" aria-label="Month" data-run-as-of-picker-month></select>
                        <input type="number" class="text-input" min="1" max="9999" step="1" aria-label="Year" data-run-as-of-picker-year />
                        <button type="button" class="run-as-of-date-arrow" aria-label="Next month" data-run-as-of-picker-next>›</button>
                    </div>
                    <div class="run-as-of-date-calendar" role="grid" aria-label="Calendar">
                        <div role="row" class="run-as-of-date-weekdays"><span role="columnheader">Su</span><span role="columnheader">Mo</span><span role="columnheader">Tu</span><span role="columnheader">We</span><span role="columnheader">Th</span><span role="columnheader">Fr</span><span role="columnheader">Sa</span></div>
                        <div class="run-as-of-date-days" role="rowgroup" data-run-as-of-picker-days></div>
                    </div>
                    <fieldset class="run-as-of-date-time"><legend>Time (24-hour)</legend>
                        <label><span>Hour</span><input type="number" class="text-input" min="0" max="23" step="1" required data-run-as-of-picker-hour /></label>
                        <label><span>Minute</span><input type="number" class="text-input" min="0" max="59" step="1" required data-run-as-of-picker-minute /></label>
                        <label><span>Second</span><input type="number" class="text-input" min="0" max="59" step="1" required data-run-as-of-picker-second /></label>
                    </fieldset>
                    <p class="field-help error" role="alert" data-run-as-of-picker-error hidden></p>
                    <div class="run-as-of-date-actions"><button type="button" data-run-as-of-picker-clear>Clear</button><button type="button" data-run-as-of-picker-ok>OK</button><button type="button" data-run-as-of-picker-today>Today</button></div>
                </div>
            </div>
            <p class="field-help">The selected values replace date/time macros for this run. MAUI saves an Undo snapshot, runs the Task, and restores the original settings after completion.</p>
            <div class="task-notification-progress"><progress max="100" value="0" data-run-as-of-progress aria-label="Run As Of progress"></progress><p data-run-as-of-status role="status" aria-live="polite"></p></div>
        </div>
        <div class="settings-footer"><button type="button" class="secondary-button" data-run-as-of-close>Close</button><button type="button" class="primary-button" data-run-as-of-run>Run</button></div>
    </div>
</dialog>
