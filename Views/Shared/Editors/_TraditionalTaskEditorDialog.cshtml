<dialog class="new-task-dialog traditional-task-editor-sync-initial-dialog" data-sync-initial-dialog>
    <div class="new-task-card">
    <div class="settings-header"><div><h2>Initial Run Options</h2><p>Choose which files to copy when no saved Sync listing exists.</p></div><button type="button" class="dialog-close" data-sync-initial-close aria-label="Close">×</button></div>
    <div class="new-task-body">
        <div class="traditional-task-editor-sync-initial-options">
            <label class="traditional-task-editor-inline-check"><input type="radio" name="maui-sync-initial-mode" value="-3" /><span>Consider files whose names match to be identical</span></label>
            <label class="traditional-task-editor-inline-check"><input type="radio" name="maui-sync-initial-mode" value="-1" /><span>Consider files whose names and sizes match to be identical</span></label>
            <label class="traditional-task-editor-inline-check"><input type="radio" name="maui-sync-initial-mode" value="custom" /><span>Match names and sizes only when timestamps are within this timespan</span></label>
            <div class="details-grid traditional-task-editor-dependent-option" data-sync-initial-timespan>
                <label class="field-block"><span>Timespan</span><input type="number" min="0" max="2147483647" step="1" class="text-input" data-sync-initial-value /></label>
                <label class="field-block"><span>Unit</span><select class="text-input" data-sync-initial-unit><option value="1">Seconds</option><option value="60">Minutes</option><option value="3600">Hours</option><option value="86400">Days</option></select></label>
            </div>
            <label class="traditional-task-editor-inline-check"><input type="radio" name="maui-sync-initial-mode" value="-2" /><span>Copy all files from Folder A to Folder B, even when unchanged</span></label>
