<dialog class="new-task-dialog" data-backup-restore-dialog>
    <div class="new-task-card backup-restore-dialog-card">
        <div class="settings-header">
            <div><h2>Restore MAUI Backup</h2><p>Restore application configuration and supported backup contents.</p></div>
            <button type="button" class="dialog-close" data-backup-restore-close aria-label="Close">×</button>
        </div>
        <div class="new-task-body backup-restore-dialog-body">
            <div class="inline-alert error-alert" data-backup-restore-error hidden></div>
            <div class="configuration-destructive-warning">
                <strong>This restore replaces the current MAUI configuration.</strong>
                <p><code>appsettings.json</code> is replaced. If the backup uses SQLite, <code>maui.db</code> is restored. SQL Server database restore is not supported. MAUI must restart after the restore.</p>
            </div>
            <div class="backup-restore-summary">
                <div><span>Backup</span><strong data-backup-restore-date>—</strong></div>
                <div><span>Metadata Database</span><strong data-backup-restore-database>—</strong></div>
                <div><span>MOVEit Configurations</span><strong data-backup-restore-moveit-summary>—</strong></div>
            </div>
            <div class="inline-alert warning-alert" data-backup-restore-sql-warning hidden>
                <strong>SQL Server metadata will not be restored.</strong> The SQL Server connection settings from this backup will be restored in <code>appsettings.json</code>, but the SQL Server database itself is unchanged.
            </div>
            <div class="backup-restore-environments">
                <strong id="backup-restore-environments-title">Restore MOVEit Automation configurations</strong>
                <p class="field-help">Select the configurations to restore from this backup. All are off by default. Each uses its Server-Key-protected export. Leave all unchecked to restore MAUI only.</p>
                <div class="backup-restore-environment-options" data-backup-restore-moveit-options role="group" aria-labelledby="backup-restore-environments-title"></div>
                <p class="field-help" data-backup-restore-multi-warning hidden>Restoring multiple MOVEit environments is not atomic. If a later restore fails, an earlier environment may already have been restored.</p>
            </div>
            <label class="backup-restore-option">
                <input type="checkbox" data-backup-restore-acknowledge />
                <span><strong>I understand the current MAUI configuration and supported metadata state will be replaced.</strong><small>A pre-restore safety copy of the current appsettings.json is created automatically.</small></span>
            </label>
            <label class="configuration-field">
                <span>Type RESTORE to confirm</span>
                <input class="text-input" autocomplete="off" spellcheck="false" data-backup-restore-confirmation />
            </label>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-backup-restore-cancel>Cancel</button>
            <button type="button" class="danger-button" data-backup-restore-confirm disabled>Restore Backup</button>
        </div>
    </div>
</dialog>

