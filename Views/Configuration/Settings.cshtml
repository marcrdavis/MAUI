<dialog class="new-task-dialog" data-system-job-edit-dialog>
    <div class="new-task-card system-job-edit-card">
        <div class="settings-header">
            <div><h2>Edit System Job</h2><p>Configure this MAUI System Job.</p></div>
            <button type="button" class="dialog-close" data-system-job-edit-close aria-label="Close">×</button>
        </div>
        <div class="new-task-body">
            <div class="inline-alert error-alert" data-system-job-edit-error hidden></div>
            <input type="hidden" data-system-job-edit-key />
            <label class="configuration-field">
                <span>Name</span>
                <input class="text-input configuration-locked-input" data-system-job-edit-name readonly />
            </label>
            <label class="configuration-field">
                <span>Job Description</span>
                <textarea class="text-input configuration-locked-input system-job-description-input" rows="2" data-system-job-edit-description readonly></textarea>
            </label>
            <div class="configuration-setting-row system-job-edit-toggle-row">
                <div><strong>Enabled</strong><p>Run this System Job automatically according to its configured schedule.</p></div>
                <label class="configuration-switch"><input type="checkbox" data-system-job-edit-enabled /><span></span></label>
            </div>
            <label class="configuration-field">
                <span>Schedule</span>
                <input class="text-input configuration-locked-input" data-system-job-edit-schedule readonly />
            </label>
            <label class="configuration-field" data-system-job-edit-time-field>
                <span>Run Daily At</span>
                <input class="text-input configuration-number-input" type="time" step="60" data-system-job-edit-time />
                <small>Time is interpreted in the MAUI application server's local time zone.</small>
            </label>
        </div>
        <div class="settings-footer new-task-footer">
            <button type="button" class="secondary-button" data-system-job-edit-cancel>Cancel</button>
            <button type="button" class="primary-button" data-system-job-edit-save>Save</button>
        </div>
    </div>
</dialog>

<div class="toast" data-configuration-toast role="status" aria-live="polite"></div>

<template data-server-template>
    <div class="configuration-server-card" data-server-row>
        <div class="configuration-server-card-header"><strong data-server-title>New MOVEit Server</strong><button type="button" class="configuration-remove-button" data-remove-server aria-label="Remove server">Remove</button></div>
        <div class="configuration-field-grid server-grid">
            <label class="configuration-field"><span>Key</span><input class="text-input configuration-locked-input" data-server-field="key" readonly /><small>Stable internal identifier generated by MAUI.</small></label>
            <label class="configuration-field"><span>Environment Key</span><input class="text-input" data-server-field="environmentKey" /><small>Shared by HA nodes that use the same Automation configuration.</small></label>
            <label class="configuration-field"><span>Display Name</span><input class="text-input" data-server-field="displayName" /></label>
            <label class="configuration-field"><span>Web Admin URL</span><input class="text-input" placeholder="https://automation.example.com" data-server-field="webAdminUrl" /></label>
            <label class="configuration-field full"><span>COM Server Host Override <em>optional</em></span><input class="text-input" data-server-field="serverHost" /><small>Leave blank to derive the COM host from the Web Admin URL.</small></label>
        </div>
        <div class="configuration-server-data-access" data-data-access-row data-server-key="" data-configured="false" data-persisted="false">
            <div><strong>Data Access Credentials</strong><p>Optional credentials for automatic backups, scheduled Reports, and unattended System Jobs. Save the server configuration first; credentials are not required during setup.</p></div>
            <div class="configuration-data-access-summary"><span><strong>Username:</strong> <span data-data-access-username>—</span></span><span><strong>Password:</strong> <span data-data-access-password-state>Not Configured</span></span></div>
            <div class="configuration-inline-actions data-access-actions"><button type="button" class="secondary-button" data-data-access-configure disabled>Configure</button><button type="button" class="secondary-button" data-data-access-test disabled>Test</button><button type="button" class="configuration-remove-button" data-data-access-clear disabled>Clear</button></div>
        </div>
    </div>
</template>

<template data-metadata-field-template>
    <div class="configuration-metadata-row" data-metadata-row>
        <label class="configuration-metadata-control"><span>Name</span><input class="text-input" data-metadata-field="name" /></label>
        <label class="configuration-metadata-control"><span>Label</span><input class="text-input" data-metadata-field="label" /></label>
        <label class="configuration-metadata-control"><span>Type</span><select class="text-input" data-metadata-field="type"><option>String</option><option>MultilineString</option><option>Email</option><option>List</option><option>Boolean</option><option>Numeric</option><option>Date</option></select></label>
        <label class="configuration-metadata-control"><span>Possible Values</span><input class="text-input" data-metadata-field="possibleValues" /></label>
        <label class="configuration-required-check configuration-metadata-required"><span>Required</span><input type="checkbox" data-metadata-field="required" /></label>
        <button type="button" class="configuration-remove-button configuration-metadata-remove" data-remove-metadata-field>Remove</button>
        <label class="configuration-metadata-control configuration-metadata-description"><span>Description</span><input class="text-input" data-metadata-field="description" /></label>
    </div>
</template>

<template data-security-user-template>
    <div class="configuration-security-row" data-security-user data-security-original="false">
        <input class="text-input" placeholder="MOVEit username" maxlength="128" data-security-field="username" />
        <select class="text-input" data-security-field="role"><option value="User" selected>User</option><option value="Admin">Admin</option></select>
        <span class="configuration-last-login">Never</span>
        <button type="button" class="configuration-remove-button" data-remove-security-user>Remove</button>
    </div>
</template>

